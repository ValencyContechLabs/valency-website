---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Header />
  <main class="bg-white">

    <!-- Hero Section -->
    <section class="relative w-full min-h-[500px] md:min-h-[600px] overflow-hidden mb-16 -mt-20 md:-mt-24">
      <div class="absolute products-hero-bg-extended" style="z-index:0; top:-80px; left:0; right:0; height:calc(100% + 80px);">
        <img
          src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1920&h=1080&fit=crop"
          class="w-full h-full object-cover products-hero-bg-image"
          alt="Valency Products"
        />
        <div class="absolute inset-0 bg-black/55"></div>
      </div>
      <div class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8 h-full flex items-center min-h-[500px] md:min-h-[600px] pt-24 md:pt-[150px]">
        <div class="max-w-4xl text-white">
          <p class="products-hero-label text-sm font-semibold uppercase tracking-widest text-white/70 mb-4">Our Products</p>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 products-hero-title">
            Everything You Need to Run a Smarter Site
          </h1>
          <p class="text-xl md:text-2xl text-white/90 leading-relaxed products-hero-description">
            Purpose-built modules for construction — from daily labour attendance to final billing. Use them individually or together as Valency 360.
          </p>
        </div>
      </div>
    </section>

    <!-- Featured: Valency 360 -->
    <section class="w-full bg-gray-950 py-16 md:py-20">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div>
              <span class="inline-block bg-white/10 text-white text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-4">All-in-One Suite</span>
              <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6">Valency 360</h2>
              <p class="text-white/80 text-lg leading-relaxed mb-8">
                One unified platform that brings together Labour, Materials, Machines, Quality, BOQ, and Procurement — giving you a real-time, end-to-end view of every project from day one to handover.
              </p>
              <ul class="space-y-3 mb-10">
                {[
                  "Single dashboard for all site operations",
                  "Integrated automated billing from daily data",
                  "Cross-module analytics and cost tracking",
                  "Real-time alerts and progress snapshots",
                  "Role-based access for office, site, and management",
                ].map(item => (
                  <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-5 h-5 rounded-full bg-white/20 flex items-center justify-center mt-0.5">
                      <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                      </svg>
                    </span>
                    <span class="text-white/80">{item}</span>
                  </li>
                ))}
              </ul>
              <div class="flex flex-wrap gap-4">
                <a href="/products/valency-360" class="bg-white text-black font-semibold px-6 py-3 rounded-full hover:bg-gray-100 transition-colors">
                  Learn More
                </a>
                <a href="/about#request-demo" class="border border-white/30 text-white font-semibold px-6 py-3 rounded-full hover:bg-white/10 transition-colors">
                  Book a Demo
                </a>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
              {[
                { name: "Labour Attendance", icon: "👷", href: "/products/labour-attendance" },
                { name: "Material Management", icon: "📦", href: "/products/material-management" },
                { name: "BOQ & Documents", icon: "📋", href: "/products/boq-document-management" },
                { name: "Work Order & PO", icon: "📝", href: "/products/work-order-management" },
                { name: "QC Management", icon: "✅", href: "/products/qc-management" },
                { name: "Machine Management", icon: "🏗️", href: "/products/machine-management" },
              ].map(mod => (
                <a href={mod.href} class="bg-white/5 border border-white/10 rounded-xl p-4 hover:bg-white/10 hover:border-white/25 transition-all group">
                  <div class="text-2xl mb-2">{mod.icon}</div>
                  <p class="text-white text-sm font-medium group-hover:text-white/90">{mod.name}</p>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Individual Products Grid -->
    <section class="w-full bg-white py-16 md:py-24">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-14">
            <p class="text-sm font-semibold uppercase tracking-widest text-gray-500 mb-3">Modular by Design</p>
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Individual Modules</h2>
            <p class="text-gray-600 text-lg max-w-2xl mx-auto">Start with what matters most to your team. Each module works standalone or plugs seamlessly into Valency 360.</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

            <!-- Labour Attendance -->
            <a href="/products/labour-attendance" class="group block bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-xl hover:border-gray-300 transition-all duration-300">
              <div class="h-48 bg-gradient-to-br from-blue-600 to-blue-800 relative overflow-hidden">
                <div class="absolute inset-0 flex items-center justify-center">
                  <svg class="w-20 h-20 text-white/20" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                  </svg>
                </div>
                <div class="absolute top-4 left-4">
                  <span class="bg-white/20 text-white text-xs font-semibold px-3 py-1 rounded-full">Priority #1</span>
                </div>
              </div>
              <div class="p-6">
                <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-blue-700 transition-colors">Labour Attendance Management</h3>
                <p class="text-gray-600 text-sm leading-relaxed mb-4">Track every worker in real time. Automate muster rolls, overtime, subcontractor billing, and activity-wise productivity — directly from site.</p>
                <div class="flex flex-wrap gap-2 mb-5">
                  {["Biometric / Mobile Check-in", "Daily Muster Roll", "Overtime & Wages", "Activity Reports"].map(tag => (
                    <span class="bg-blue-50 text-blue-700 text-xs px-2 py-1 rounded-full">{tag}</span>
                  ))}
                </div>
                <span class="text-blue-700 font-semibold text-sm group-hover:underline">Explore Module →</span>
              </div>
            </a>

            <!-- Material Management -->
            <a href="/products/material-management" class="group block bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-xl hover:border-gray-300 transition-all duration-300">
              <div class="h-48 bg-gradient-to-br from-emerald-600 to-emerald-800 relative overflow-hidden">
                <div class="absolute inset-0 flex items-center justify-center">
                  <svg class="w-20 h-20 text-white/20" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20 7H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V9c0-1.1-.9-2-2-2zm-9 9H5v-2h6v2zm8-4H5v-2h14v2zM15 3H9L7 7h10l-2-4z"/>
                  </svg>
                </div>
                <div class="absolute top-4 left-4">
                  <span class="bg-white/20 text-white text-xs font-semibold px-3 py-1 rounded-full">Priority #2</span>
                </div>
              </div>
              <div class="p-6">
                <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-emerald-700 transition-colors">Material Management</h3>
                <p class="text-gray-600 text-sm leading-relaxed mb-4">From indent to GRN to consumption — track every material in and out of your site. Compare actuals vs BOQ and eliminate wastage.</p>
                <div class="flex flex-wrap gap-2 mb-5">
                  {["Indent & GRN", "Stock Ledger", "Wastage Tracking", "BOQ vs Actuals"].map(tag => (
                    <span class="bg-emerald-50 text-emerald-700 text-xs px-2 py-1 rounded-full">{tag}</span>
                  ))}
                </div>
                <span class="text-emerald-700 font-semibold text-sm group-hover:underline">Explore Module →</span>
              </div>
            </a>

            <!-- BOQ & Document Management -->
            <a href="/products/boq-document-management" class="group block bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-xl hover:border-gray-300 transition-all duration-300">
              <div class="h-48 bg-gradient-to-br from-violet-600 to-violet-800 relative overflow-hidden">
                <div class="absolute inset-0 flex items-center justify-center">
                  <svg class="w-20 h-20 text-white/20" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
                  </svg>
                </div>
                <div class="absolute top-4 left-4">
                  <span class="bg-white/20 text-white text-xs font-semibold px-3 py-1 rounded-full">Priority #3</span>
                </div>
              </div>
              <div class="p-6">
                <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-violet-700 transition-colors">BOQ & Document Management</h3>
                <p class="text-gray-600 text-sm leading-relaxed mb-4">Manage your Bill of Quantities, drawings, and project documents in one place. Track revisions, progress billing, and variation orders with full version control.</p>
                <div class="flex flex-wrap gap-2 mb-5">
                  {["Bill of Quantities", "Drawing Control", "Progress Billing", "Variation Orders"].map(tag => (
                    <span class="bg-violet-50 text-violet-700 text-xs px-2 py-1 rounded-full">{tag}</span>
                  ))}
                </div>
                <span class="text-violet-700 font-semibold text-sm group-hover:underline">Explore Module →</span>
              </div>
            </a>

            <!-- Work Order & PO -->
            <a href="/products/work-order-management" class="group block bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-xl hover:border-gray-300 transition-all duration-300">
              <div class="h-48 bg-gradient-to-br from-orange-500 to-orange-700 relative overflow-hidden">
                <div class="absolute inset-0 flex items-center justify-center">
                  <svg class="w-20 h-20 text-white/20" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.93 0 3.5 1.57 3.5 3.5S13.93 13 12 13s-3.5-1.57-3.5-3.5S10.07 6 12 6zm7 13H5v-.23c0-.62.28-1.2.76-1.58C7.47 15.82 9.64 15 12 15s4.53.82 6.24 2.19c.48.38.76.97.76 1.58V19z"/>
                  </svg>
                </div>
                <div class="absolute top-4 left-4">
                  <span class="bg-white/20 text-white text-xs font-semibold px-3 py-1 rounded-full">Priority #4</span>
                </div>
              </div>
              <div class="p-6">
                <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-orange-600 transition-colors">Work Order & Purchase Order (ENFA) Management</h3>
                <p class="text-gray-600 text-sm leading-relaxed mb-4">Issue, track, and close work orders and purchase orders with full approval workflows. ENFA-ready with PO-to-invoice matching and subcontractor accountability.</p>
                <div class="flex flex-wrap gap-2 mb-5">
                  {["Work Orders", "Purchase Orders", "ENFA Workflow", "Approval Chains"].map(tag => (
                    <span class="bg-orange-50 text-orange-700 text-xs px-2 py-1 rounded-full">{tag}</span>
                  ))}
                </div>
                <span class="text-orange-600 font-semibold text-sm group-hover:underline">Explore Module →</span>
              </div>
            </a>

            <!-- QC Management -->
            <a href="/products/qc-management" class="group block bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-xl hover:border-gray-300 transition-all duration-300">
              <div class="h-48 bg-gradient-to-br from-rose-600 to-rose-800 relative overflow-hidden">
                <div class="absolute inset-0 flex items-center justify-center">
                  <svg class="w-20 h-20 text-white/20" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                  </svg>
                </div>
                <div class="absolute top-4 left-4">
                  <span class="bg-white/20 text-white text-xs font-semibold px-3 py-1 rounded-full">Priority #5</span>
                </div>
              </div>
              <div class="p-6">
                <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-rose-700 transition-colors">QC (Quality Check) Management</h3>
                <p class="text-gray-600 text-sm leading-relaxed mb-4">Enforce quality at every stage. Digital inspection checklists, NCR tracking, photo evidence, and punch lists — so nothing gets missed before handover.</p>
                <div class="flex flex-wrap gap-2 mb-5">
                  {["Inspection Checklists", "NCR Tracking", "Defect Logs", "Photo Evidence"].map(tag => (
                    <span class="bg-rose-50 text-rose-700 text-xs px-2 py-1 rounded-full">{tag}</span>
                  ))}
                </div>
                <span class="text-rose-700 font-semibold text-sm group-hover:underline">Explore Module →</span>
              </div>
            </a>

            <!-- Machine Management -->
            <a href="/products/machine-management" class="group block bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-xl hover:border-gray-300 transition-all duration-300">
              <div class="h-48 bg-gradient-to-br from-slate-600 to-slate-800 relative overflow-hidden">
                <div class="absolute inset-0 flex items-center justify-center">
                  <svg class="w-20 h-20 text-white/20" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M22 9V7h-2V5c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-2h2v-2h-2v-2h2v-2h-2V9h2zm-4 10H4V5h14v14z"/>
                  </svg>
                </div>
                <div class="absolute top-4 left-4">
                  <span class="bg-white/20 text-white text-xs font-semibold px-3 py-1 rounded-full">Priority #6</span>
                </div>
              </div>
              <div class="p-6">
                <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-slate-700 transition-colors">Machine Management</h3>
                <p class="text-gray-600 text-sm leading-relaxed mb-4">Log machine hours, fuel usage, operator assignments, and maintenance schedules. Allocate equipment costs to specific activities and track idle time.</p>
                <div class="flex flex-wrap gap-2 mb-5">
                  {["Hour Logging", "Fuel Tracking", "Maintenance", "Cost Allocation"].map(tag => (
                    <span class="bg-slate-100 text-slate-700 text-xs px-2 py-1 rounded-full">{tag}</span>
                  ))}
                </div>
                <span class="text-slate-700 font-semibold text-sm group-hover:underline">Explore Module →</span>
              </div>
            </a>

          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="w-full bg-gray-950 py-16 md:py-20">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Not sure where to start?</h2>
        <p class="text-white/70 text-lg mb-8 max-w-xl mx-auto">Talk to a Valency expert and we'll recommend the right modules for your project type and team size.</p>
        <a href="/about#request-demo" class="inline-block bg-white text-black font-semibold px-8 py-3 rounded-full hover:bg-gray-100 transition-colors">
          Book a Free Demo
        </a>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  .products-hero-bg-image {
    opacity: 0;
    transform: scale(1.1);
    animation: productsBgFadeIn 2.4s ease-out forwards;
  }
  @keyframes productsBgFadeIn {
    to { opacity: 1; transform: scale(1); }
  }
  .products-hero-label {
    opacity: 0;
    transform: translateY(20px);
    animation: productsHeroFadeIn 1.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: 0.3s;
  }
  .products-hero-title {
    opacity: 0;
    transform: translateY(30px);
    animation: productsHeroFadeIn 1.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: 0.6s;
  }
  .products-hero-description {
    opacity: 0;
    transform: translateY(30px);
    animation: productsHeroFadeIn 1.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: 1s;
  }
  @keyframes productsHeroFadeIn {
    to { opacity: 1; transform: translateY(0); }
  }
</style>
