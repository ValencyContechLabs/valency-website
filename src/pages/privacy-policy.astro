---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const lastUpdated = "August 18, 2026";

const definitions = [
  ["Account", "means a unique account created for you to access our Service."],
  ["Administrator", "means an authorized user responsible for creating and managing other user profiles within the Service."],
  ["Application", "refers to Valency, the software program provided by the Company."],
  ["Company", "refers to Valency ConTech, 40, Chinnathottam, Periya Semur, Erode, Tamil Nadu - 638004, India."],
  ["Country", "refers to India."],
  ["Device", "means any device that can access the Service, such as a computer, smartphone, or tablet."],
  ["Personal Data", "is any information that relates to an identified or identifiable individual."],
  ["Service", "refers to the Application."],
  ["Service Provider", "means any natural or legal person who processes data on behalf of the Company."],
  ["Usage Data", "refers to data collected automatically, either generated by the use of the Service or from the Service infrastructure itself."],
  ["You", "means the individual accessing or using the Service, or the company, or other legal entity on behalf of which such individual is accessing or using the Service."],
];

const personalData = [
  "Name",
  "Email address",
  "Phone number",
  "Address (including State, Province, ZIP/Postal code, City)",
  "Attendance logs",
  "Location data (when required for attendance or site tracking purposes)",
  "Photos or attachments for task justification",
];

const usageData = [
  "Your Device's Internet Protocol address (IP address)",
  "Browser type and version",
  "Mobile device information (model, unique device identifiers, OS version)",
  "Time and date of your visit, time spent in the app",
  "Diagnostic data",
];

const useOfData = [
  "To provide and maintain the Service, including monitoring usage.",
  "To manage user accounts, including registration, attendance, and task tracking.",
  "To perform contracts related to services provided by the Company.",
  "To contact users if necessary regarding service updates or account matters.",
  "To improve the Service, including data analysis, usage trends, and app optimization.",
];

const sharing = [
  "With Service Providers",
  "For Business Transfers",
  "With Affiliates",
  "With Authorized Business Partners",
  "With your Consent",
];
---

<Layout
  title="Privacy Policy | Valency"
  description="How Valency collects, uses, and protects your personal data."
>
  <Header />
  <main class="bg-white">
    <!-- Hero -->
    <section
      class="relative w-full bg-blue-900 min-h-[480px] md:min-h-[560px] -mt-20 md:-mt-24"
    >
      <div
        class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8 flex items-center min-h-[480px] md:min-h-[560px] pt-28 md:pt-[160px] pb-20 md:pb-28"
      >
        <div class="max-w-4xl text-white">
          <h1
            class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight pb-2 mb-6"
          >
            Privacy Policy
          </h1>
          <p class="text-lg md:text-xl text-white/80 leading-relaxed">
            This Privacy Policy describes our policies and procedures on the
            collection, use, and disclosure of your information when you use the
            Service, and informs you about your privacy rights and how the law
            protects you.
          </p>
          <p class="text-sm text-white/60 mt-8">Last updated: {lastUpdated}</p>
        </div>
      </div>
    </section>

    <!-- Content -->
    <section class="w-full bg-white py-16 md:py-24">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto policy-body">
          <p>
            By using the Service, you agree to the collection and use of
            information in accordance with this Privacy Policy.
          </p>

          <h2>Interpretation and Definitions</h2>

          <h3>Interpretation</h3>
          <p>
            Words with initial capital letters have meanings defined under the
            following conditions. The following definitions shall have the same
            meaning regardless of whether they appear in singular or plural.
          </p>

          <h3>Definitions</h3>
          <p>For the purposes of this Privacy Policy:</p>
          <ul>
            {definitions.map(([term, meaning]) => (
              <li><strong>{term}</strong> {meaning}</li>
            ))}
          </ul>

          <h2>Application Usage</h2>
          <p>
            This Application is designed for internal use by companies,
            specifically in the construction industry. All user accounts are
            created and managed by authorized administrators. Public
            self-registration by users is not available.
          </p>

          <h2>Collecting and Using Your Personal Data</h2>

          <h3>Types of Data Collected</h3>

          <h4>Personal Data</h4>
          <p>
            While using our Service, authorized administrators may enter or
            manage the following personal data of users:
          </p>
          <ul>
            {personalData.map((item) => <li>{item}</li>)}
          </ul>

          <h4>Usage Data</h4>
          <p>
            Usage Data is collected automatically when using the Service and may
            include:
          </p>
          <ul>
            {usageData.map((item) => <li>{item}</li>)}
          </ul>

          <h3>Information Collected via Mobile Permissions</h3>
          <p>With your prior permission, the Application may access:</p>
          <ul>
            <li>Camera or photo gallery (for uploading task-related evidence)</li>
            <li>Location (for attendance and activity verification)</li>
          </ul>
          <p>
            Permissions can be enabled or disabled at any time through your
            device settings.
          </p>

          <h2>Use of Your Personal Data</h2>
          <p>The Company uses personal data for the following purposes:</p>
          <ul>
            {useOfData.map((item) => <li>{item}</li>)}
          </ul>
          <p class="policy-note">
            <strong>Note:</strong> We do not use your personal data for marketing,
            advertising, or promotional communications.
          </p>

          <h2>Sharing of Your Personal Data</h2>
          <p>We may share your personal data in the following cases:</p>
          <ul>
            {sharing.map((item) => <li>{item}</li>)}
          </ul>

          <h2>Retention of Your Personal Data</h2>
          <p>
            We retain personal data only as long as necessary to fulfill the
            purposes described in this Privacy Policy, unless a longer retention
            period is required by law.
          </p>

          <h2>Transfer of Your Personal Data</h2>
          <p>
            Your information may be transferred to — and maintained on —
            computers located outside your country where data protection laws
            may differ.
          </p>

          <h2>Delete Your Personal Data</h2>
          <p>
            You can request deletion of your personal data at any time by
            contacting your administrator or reaching out to us directly.
          </p>

          <h2>Security of Your Personal Data</h2>
          <p>
            The security of your personal data is important to us. We implement
            commercially acceptable measures to protect it, but no system can
            guarantee 100% security.
          </p>

          <h2>Children's Privacy</h2>
          <p>
            Our Service is not intended for individuals under the age of 13. We
            do not knowingly collect personal data from minors.
          </p>

          <h2>Links to Other Websites</h2>
          <p>
            Our Service may contain links to external websites. We are not
            responsible for their content, policies, or practices.
          </p>

          <h2>Changes to this Privacy Policy</h2>
          <p>
            We may update this Privacy Policy. We will notify you of any changes
            by posting the new Privacy Policy on this page and updating the
            "Last updated" date.
          </p>

          <h2>Contact Us</h2>
          <p>
            If you have any questions about this Privacy Policy, you can contact
            us:
          </p>
          <ul>
            <li>By email: <a href="mailto:hello@valency.in">hello@valency.in</a></li>
            <li>By phone: <a href="tel:+917598042044">(+91) 7598042044</a></li>
            <li>By post: 40, Chinnathottam, Periya Semur, Erode, Tamil Nadu - 638004</li>
          </ul>

          <div class="mt-12 pt-8 border-t border-gray-200">
            <a
              href="/cookies-policy"
              class="inline-flex items-center gap-2 text-blue-900 font-semibold hover:underline"
            >
              Read our Cookies Policy
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path></svg
              >
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .policy-body {
    color: #374151;
    line-height: 1.75;
  }

  .policy-body h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: #111827;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  .policy-body h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #111827;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .policy-body h4 {
    font-size: 1.0625rem;
    font-weight: 600;
    color: #1f2937;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .policy-body p {
    margin-bottom: 1.25rem;
  }

  .policy-body ul {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .policy-body li {
    margin-bottom: 0.625rem;
  }

  .policy-body a {
    color: #1e3a8a;
    text-decoration: underline;
  }

  .policy-body .policy-note {
    background: #f3f4f6;
    border-left: 4px solid #1e3a8a;
    padding: 1rem 1.25rem;
    border-radius: 0.375rem;
  }

  .policy-body .policy-note a,
  .policy-body .mt-12 a {
    text-decoration: none;
  }
</style>
