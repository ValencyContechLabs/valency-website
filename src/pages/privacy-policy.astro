---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

/*
  One privacy policy for every Valency construction application — Valency 360
  and its modules, and RMC Concrete Management (ValencyConcrete) — the link
  given on each app's Google Play listing. Keep it in step with the apps: a new permission, a
  new kind of data or a new service provider in any app must be added here, and
  in that app's Data safety form in Play Console.
*/
const lastUpdated = "November 26, 2026";

const definitions = [
  ["Account", "means a unique account created for you to access our Service."],
  ["Administrator", "means an authorized user responsible for creating and managing other user profiles within the Service."],
  ["Application", "refers to any construction management software application provided by the Company, on mobile or web, including Valency 360 and its modules (Labour Attendance, Material Management, Machine Management, Work Order Management, BOQ & Document Management and QC Management) and RMC Concrete Management (the ValencyConcrete app)."],
  ["Company", "refers to Valency ConTech, 40, Chinnathottam, Periya Semur, Erode, Tamil Nadu - 638004, India."],
  ["Country", "refers to India."],
  ["Device", "means any device that can access the Service, such as a computer, smartphone, or tablet."],
  ["Personal Data", "is any information that relates to an identified or identifiable individual."],
  ["Service", "refers to the Applications."],
  ["Service Provider", "means any natural or legal person who processes data on behalf of the Company."],
  ["Usage Data", "refers to data collected automatically, either generated by the use of the Service or from the Service infrastructure itself."],
  ["You", "means the individual accessing or using the Service, or the company, or other legal entity on behalf of which such individual is accessing or using the Service."],
];

const personalData = [
  "Name and username",
  "Email address",
  "Phone number",
  "Address (including State, Province, ZIP/Postal code, City)",
  "Your role, and the projects, sites or plants you work with",
  "Your password, which is stored only in hashed (one-way encrypted) form and is never visible to anyone",
];

const workData = [
  "Attendance and muster records, including check-in and check-out times",
  "Tasks, work orders and purchase orders",
  "Material indents, goods receipts, stock and consumption records",
  "Machine hour logs, fuel and maintenance records",
  "Bills of quantities, drawings and other project documents",
  "Quality inspections, checklists and non-conformance reports",
  "Concrete requests: project, site and structure, concrete grade, quantities, schedule and remarks",
  "Site contact details for a pour, if entered: name, phone number and email address",
  "Dispatch and delivery records, including vehicle numbers and driver names",
  "Quality records, such as cube test results",
  "Photos or attachments, such as task evidence, inspection photos, dispatch documents or test photos",
];

const usageData = [
  "Your Device's Internet Protocol address (IP address)",
  "Browser type and version",
  "Mobile device information (model, unique device identifiers, OS version)",
  "The Application's version and build number",
  "A push notification token, so the Application can send you alerts",
  "Time and date of your visit, time spent in the app",
  "Diagnostic data",
];

const permissions = [
  ["Camera or photo gallery", "to take or attach photos, such as task evidence, inspection photos, dispatch documents or test photos, only when you choose to."],
  ["Location", "for attendance and activity verification, only in the Applications and features that need it, such as Labour Attendance. Applications that do not need it, such as ValencyConcrete, never ask for it."],
  ["Notifications", "to alert you about work that concerns you, such as tasks, requests, approvals and deliveries."],
  ["Storage", "on Android 9 and older only, to save photos and files you choose to keep."],
];

const useOfData = [
  "To provide and maintain the Service, including monitoring usage.",
  "To manage user accounts, sign you in, and show you only what your role allows.",
  "To run the features your organisation uses, such as attendance, task tracking, materials, concrete requests, dispatch and quality records.",
  "To send you notifications about work that concerns you.",
  "To deliver updates to the Applications.",
  "To perform contracts related to services provided by the Company.",
  "To contact users if necessary regarding service updates or account matters.",
  "To keep the Service secure, find and fix problems, and answer support requests.",
  "To improve the Service, including data analysis, usage trends, and app optimization.",
];

const sharing = [
  ["Within your organisation", "other users of your organisation's account see the records they need for their work, according to the roles and permissions your Administrator sets."],
  ["With Service Providers", "companies that run the Service for us and may only use the data to do so, such as cloud hosting and file storage (for example, Amazon Web Services) and Google Firebase (push notifications and app updates)."],
  ["For Business Transfers", "if the Company is merged, acquired or sells its assets, subject to this Privacy Policy."],
  ["With Affiliates", "who are required to honour this Privacy Policy."],
  ["With Authorized Business Partners", "only as needed to provide the Service your organisation has asked for."],
  ["For legal reasons", "when required by law, or to protect the rights, safety or property of our users, the public or the Company."],
  ["With your Consent", "for any other purpose you agree to."],
];
---

<Layout
  title="Privacy Policy | Valency"
  description="How Valency's construction applications collect, use, and protect your personal data."
>
  <Header />
  <main class="bg-white">
    <!-- Hero -->
    <section
      class="relative w-full bg-blue-900 min-h-[480px] md:min-h-[560px] -mt-20 md:-mt-24"
    >
      <div
        class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8 flex items-center min-h-[480px] md:min-h-[560px] pt-28 md:pt-[160px] pb-20 md:pb-28"
      >
        <div class="max-w-4xl text-white">
          <h1
            class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight pb-2 mb-6"
          >
            Privacy Policy
          </h1>
          <p class="text-lg md:text-xl text-white/80 leading-relaxed">
            This Privacy Policy describes our policies and procedures on the
            collection, use, and disclosure of your information when you use any
            Valency construction application, and informs you about your
            privacy rights and how the law protects you.
          </p>
          <p class="text-sm text-white/60 mt-8">Last updated: {lastUpdated}</p>
        </div>
      </div>
    </section>

    <!-- Content -->
    <section class="w-full bg-white py-16 md:py-24">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto policy-body">
          <p>
            This Privacy Policy applies to all of the Company's construction
            Applications, on mobile and web: Valency 360 and its modules —
            Labour Attendance, Material Management, Machine Management, Work
            Order Management, BOQ &amp; Document Management and QC Management —
            and RMC Concrete Management (the ValencyConcrete app). By using the
            Service, you agree to the collection and use of information in
            accordance with this Privacy Policy.
          </p>

          <h2>Interpretation and Definitions</h2>

          <h3>Interpretation</h3>
          <p>
            Words with initial capital letters have meanings defined under the
            following conditions. The following definitions shall have the same
            meaning regardless of whether they appear in singular or plural.
          </p>

          <h3>Definitions</h3>
          <p>For the purposes of this Privacy Policy:</p>
          <ul>
            {definitions.map(([term, meaning]) => (
              <li><strong>{term}</strong> {meaning}</li>
            ))}
          </ul>

          <h2>Application Usage</h2>
          <p>
            The Applications are designed for internal use by companies,
            specifically in the construction industry. All user accounts are
            created and managed by authorized administrators. Public
            self-registration by users is not available. Your organisation
            decides which Applications and features it uses, so the information
            collected depends on those features.
          </p>

          <h2>Collecting and Using Your Personal Data</h2>

          <h3>Types of Data Collected</h3>

          <h4>Personal Data</h4>
          <p>
            While using our Service, authorized administrators may enter or
            manage the following personal data of users:
          </p>
          <ul>
            {personalData.map((item) => <li>{item}</li>)}
          </ul>

          <h4>Work Records</h4>
          <p>
            Information you and your colleagues enter while using the Service,
            depending on the features your organisation uses:
          </p>
          <ul>
            {workData.map((item) => <li>{item}</li>)}
          </ul>

          <h4>Usage Data</h4>
          <p>
            Usage Data is collected automatically when using the Service and may
            include:
          </p>
          <ul>
            {usageData.map((item) => <li>{item}</li>)}
          </ul>

          <h3>Information Collected via Mobile Permissions</h3>
          <p>
            With your prior permission, an Application may access the following,
            depending on its features:
          </p>
          <ul>
            {permissions.map(([name, why]) => (
              <li><strong>{name}:</strong> {why}</li>
            ))}
          </ul>
          <p>
            Permissions can be enabled or disabled at any time through your
            device settings.
          </p>
          <p>
            The Applications do not access your contacts, call logs or
            microphone, and do not track you across other apps or websites.
          </p>

          <h2>Use of Your Personal Data</h2>
          <p>The Company uses personal data for the following purposes:</p>
          <ul>
            {useOfData.map((item) => <li>{item}</li>)}
          </ul>
          <p class="policy-note">
            <strong>Note:</strong> We do not sell your personal data, and we do
            not use it for marketing, advertising, or promotional
            communications.
          </p>

          <h2>Sharing of Your Personal Data</h2>
          <p>We may share your personal data in the following cases:</p>
          <ul>
            {sharing.map(([who, what]) => (
              <li><strong>{who}:</strong> {what}</li>
            ))}
          </ul>

          <h2>Retention of Your Personal Data</h2>
          <p>
            We retain personal data only as long as necessary to fulfill the
            purposes described in this Privacy Policy, unless a longer retention
            period is required by law. Work records, such as attendance,
            dispatch and quality records, are business records of your
            organisation and are kept for as long as your organisation uses the
            Service, or longer where the law requires.
          </p>

          <h2>Transfer of Your Personal Data</h2>
          <p>
            Your information may be transferred to — and maintained on —
            computers located outside your country where data protection laws
            may differ.
          </p>

          <h2>Delete Your Personal Data</h2>
          <p>
            You can request deletion of your account and personal data at any
            time by contacting your administrator, or by emailing us at
            <a href="mailto:hello@valency.in?subject=Account%20deletion%20request">hello@valency.in</a>
            with the name of the Application you use. Records you created may
            keep your name where needed to keep your organisation's business
            records complete, or where the law requires us to keep them.
          </p>

          <h2>Security of Your Personal Data</h2>
          <p>
            The security of your personal data is important to us. The
            Applications communicate with our servers over encrypted (HTTPS)
            connections, access is limited by role-based permissions, and
            passwords are stored only in hashed form. We implement commercially
            acceptable measures to protect your data, but no system can
            guarantee 100% security.
          </p>

          <h2>Children's Privacy</h2>
          <p>
            Our Service is not intended for individuals under the age of 13. We
            do not knowingly collect personal data from minors.
          </p>

          <h2>Links to Other Websites</h2>
          <p>
            Our Service may contain links to external websites. We are not
            responsible for their content, policies, or practices.
          </p>

          <h2>Changes to this Privacy Policy</h2>
          <p>
            We may update this Privacy Policy. We will notify you of any changes
            by posting the new Privacy Policy on this page and updating the
            "Last updated" date.
          </p>

          <h2>Contact Us</h2>
          <p>
            If you have any questions about this Privacy Policy, you can contact
            us:
          </p>
          <ul>
            <li>By email: <a href="mailto:hello@valency.in">hello@valency.in</a></li>
            <li>By phone: <a href="tel:+917598042044">(+91) 7598042044</a></li>
            <li>By post: 40, Chinnathottam, Periya Semur, Erode, Tamil Nadu - 638004</li>
          </ul>

          <div class="mt-12 pt-8 border-t border-gray-200">
            <a
              href="/cookies-policy"
              class="inline-flex items-center gap-2 text-blue-900 font-semibold hover:underline"
            >
              Read our Cookies Policy
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path></svg
              >
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .policy-body {
    color: #374151;
    line-height: 1.75;
  }

  .policy-body h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: #111827;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  .policy-body h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #111827;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .policy-body h4 {
    font-size: 1.0625rem;
    font-weight: 600;
    color: #1f2937;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .policy-body p {
    margin-bottom: 1.25rem;
  }

  .policy-body ul {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .policy-body li {
    margin-bottom: 0.625rem;
  }

  .policy-body a {
    color: #1e3a8a;
    text-decoration: underline;
  }

  .policy-body .policy-note {
    background: #f3f4f6;
    border-left: 4px solid #1e3a8a;
    padding: 1rem 1.25rem;
    border-radius: 0.375rem;
  }

  .policy-body .policy-note a,
  .policy-body .mt-12 a {
    text-decoration: none;
  }
</style>
