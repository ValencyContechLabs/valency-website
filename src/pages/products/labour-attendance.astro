---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FeatureIcon from "../../components/FeatureIcon.astro";
---

<Layout>
  <Header />
  <main class="bg-white">

    <!-- Hero -->
    <section class="relative w-full min-h-[560px] md:min-h-[640px] overflow-hidden -mt-20 md:-mt-24">
      <div class="absolute inset-0" style="top:-80px; height:calc(100% + 80px);">
        <img
          src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1920&h=1080&fit=crop"
          class="w-full h-full object-cover hero-bg"
          alt="Labour Attendance Management"
        />
        <div class="absolute inset-0 bg-blue-900/70"></div>
      </div>
      <div class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8 flex items-center min-h-[560px] md:min-h-[640px] pt-28 md:pt-[160px]">
        <div class="max-w-4xl text-white">
          <a href="/products" class="hero-badge inline-flex items-center gap-2 text-white/70 text-sm hover:text-white mb-6 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            All Products
          </a>
          <div class="inline-block bg-blue-500/30 border border-blue-400/40 text-blue-200 text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-4">Labour Module</div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 hero-title">Labour Attendance Management</h1>
          <p class="text-xl text-white/85 leading-relaxed hero-desc max-w-3xl">
            Know who's on site, what they're doing, and what it's costing you — in real time. Replace paper muster rolls with a digital system that drives automated billing.
          </p>
          <div class="hero-cta flex flex-wrap gap-4 mt-10">
            <a href="/about#request-demo" class="bg-white text-blue-900 font-semibold px-7 py-3 rounded-full hover:bg-blue-50 transition-colors">Book a Demo</a>
            <a href="/products/valency-360" class="border border-white/40 text-white font-semibold px-7 py-3 rounded-full hover:bg-white/10 transition-colors">See Full Suite</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Problem & Solution -->
    <section class="w-full bg-white py-16 md:py-24">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <div>
              <p class="text-sm font-semibold uppercase tracking-widest text-gray-900 mb-3">The Problem</p>
              <h2 class="text-3xl font-bold text-gray-900 mb-6">Labour is Your Biggest Cost — and Your Biggest Blind Spot</h2>
              <p class="text-gray-600 leading-relaxed mb-6">
                Most construction sites still track attendance on paper or in spreadsheets. The result? Inflated headcounts, wage disputes, delayed billing, and no visibility into which activities are actually getting done.
              </p>
              <ul class="space-y-3">
                {[
                  "Muster rolls completed hours after the fact",
                  "No link between attendance and billing",
                  "Subcontractor counts impossible to verify",
                  "Productivity data non-existent",
                ].map(p => (
                  <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-5 h-5 rounded-full bg-red-100 flex items-center justify-center mt-0.5">
                      <svg class="w-3 h-3 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </span>
                    <span class="text-gray-600 text-sm">{p}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <p class="text-sm font-semibold uppercase tracking-widest text-gray-900 mb-3">The Solution</p>
              <h2 class="text-3xl font-bold text-gray-900 mb-6">Digital Attendance That Powers Automated Billing</h2>
              <p class="text-gray-600 leading-relaxed mb-6">
                Valency's Labour Attendance module captures real-time check-in/out via mobile or biometric device. Every entry feeds directly into wage calculations, billing, and productivity reports — automatically.
              </p>
              <ul class="space-y-3">
                {[
                  "Live headcount visible to management at any time",
                  "Billing generated from attendance — no manual entry",
                  "Subcontractor-wise breakdowns verified daily",
                  "Activity-wise productivity tracked per worker",
                ].map(s => (
                  <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-5 h-5 rounded-full bg-blue-100 flex items-center justify-center mt-0.5">
                      <svg class="w-3 h-3 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                    </span>
                    <span class="text-gray-600 text-sm">{s}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="w-full bg-gray-50 py-16 md:py-24">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto">
          <div class="text-center mb-14">
            <p class="text-sm font-semibold uppercase tracking-widest text-gray-500 mb-3">Features</p>
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900">Everything You Need to Manage Your Workforce</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {[
              { icon: "device-phone", title: "Mobile & Biometric Check-In", desc: "Workers check in via mobile app or biometric device. GPS-tagged entries prevent proxy attendance." },
              { icon: "clipboard-list", title: "Automated Muster Rolls", desc: "Daily muster rolls generated automatically — no more manual compilation at the end of the day." },
              { icon: "clock", title: "Overtime & Shift Management", desc: "Configure shift timings, grace periods, and overtime rules. Deductions and additions calculated automatically." },
              { icon: "banknotes", title: "Wage & Billing Automation", desc: "Wage sheets generated from attendance data. Subcontractor billing runs with one click." },
              { icon: "squares", title: "Activity-Wise Deployment", desc: "Assign workers to specific activities or work packages. Track productivity and cost per activity." },
              { icon: "users", title: "Subcontractor Management", desc: "Manage multiple subcontractors with individual headcount, rate cards, and billing breakdowns." },
              { icon: "chart-bar", title: "Productivity Reports", desc: "Compare planned vs actual deployment. Identify bottlenecks and underperforming activities instantly." },
              { icon: "bell", title: "Alerts & Exceptions", desc: "Get notified on absenteeism spikes, unusual overtime, or headcount deviations from plan." },
              { icon: "folder", title: "Compliance & Statutory Records", desc: "Maintain statutory registers, PF/ESI records, and ID documentation for labour compliance." },
            ].map(f => (
              <div class="bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-shadow">
                <div class="w-11 h-11 rounded-xl bg-blue-50 border border-blue-100 flex items-center justify-center mb-4"><FeatureIcon name={f.icon} class="w-6 h-6 text-blue-700" /></div>
                <h3 class="text-base font-bold text-gray-900 mb-2">{f.title}</h3>
                <p class="text-gray-600 text-sm leading-relaxed">{f.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="w-full bg-white py-16 md:py-20">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <p class="text-sm font-semibold uppercase tracking-widest text-gray-500 mb-3">Workflow</p>
            <h2 class="text-3xl font-bold text-gray-900">From Check-In to Invoice in 4 Steps</h2>
          </div>
          <div class="relative">
            <div class="absolute left-6 top-0 bottom-0 w-0.5 bg-gray-200 hidden md:block"></div>
            <div class="space-y-10">
              {[
                { step: "1", title: "Worker Check-In", desc: "Workers or supervisors mark attendance via mobile app or biometric at the start of each shift. Location is captured." },
                { step: "2", title: "Activity Assignment", desc: "Supervisors assign workers to specific activities or work packages for the day. This links attendance to productivity." },
                { step: "3", title: "Daily Muster Roll Generation", desc: "At day-end, the system auto-generates the complete muster roll with headcount, hours, and activity breakdown for supervisor approval." },
                { step: "4", title: "Automated Wage & Billing Output", desc: "Approved attendance data flows into wage calculations, subcontractor billing, and project cost reports — with zero manual re-entry." },
              ].map(s => (
                <div class="flex gap-6">
                  <div class="flex-shrink-0 w-12 h-12 bg-blue-600 rounded-full flex items-center justify-center text-white font-bold text-lg z-10">{s.step}</div>
                  <div class="pt-2">
                    <h3 class="text-lg font-bold text-gray-900 mb-1">{s.title}</h3>
                    <p class="text-gray-600 text-sm leading-relaxed">{s.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="w-full bg-blue-700 py-14 md:py-20">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Stop guessing. Start knowing who's on site.</h2>
        <p class="text-blue-100 text-lg mb-8 max-w-xl mx-auto">See a live demo of Valency's Labour Attendance module with your own project data.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/about#request-demo" class="bg-white text-blue-700 font-semibold px-8 py-3 rounded-full hover:bg-blue-50 transition-colors">Book a Demo</a>
          <a href="/products/valency-360" class="border border-white/40 text-white font-semibold px-8 py-3 rounded-full hover:bg-white/10 transition-colors">Explore Valency 360</a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  .hero-bg { opacity:0; transform:scale(1.1); animation:bgFade 2.4s ease-out forwards; }
  .hero-badge { opacity:0; animation:fadeUp 1s ease-out forwards; animation-delay:0.3s; }
  .hero-title { opacity:0; transform:translateY(30px); animation:fadeUp 1.6s cubic-bezier(0.34,1.56,0.64,1) forwards; animation-delay:0.5s; }
  .hero-desc { opacity:0; transform:translateY(30px); animation:fadeUp 1.6s cubic-bezier(0.34,1.56,0.64,1) forwards; animation-delay:0.8s; }
  .hero-cta { opacity:0; transform:translateY(20px); animation:fadeUp 1.4s cubic-bezier(0.34,1.56,0.64,1) forwards; animation-delay:1.1s; }
  @keyframes bgFade { to { opacity:1; transform:scale(1); } }
  @keyframes fadeUp { to { opacity:1; transform:translateY(0); } }
</style>
