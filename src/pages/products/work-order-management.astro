---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<Layout>
  <Header />
  <main class="bg-white">

    <!-- Hero -->
    <section class="relative w-full min-h-[560px] md:min-h-[640px] overflow-hidden -mt-20 md:-mt-24">
      <div class="absolute inset-0" style="top:-80px; height:calc(100% + 80px);">
        <img
          src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=1920&h=1080&fit=crop"
          class="w-full h-full object-cover hero-bg"
          alt="Work Order and Purchase Order Management"
        />
        <div class="absolute inset-0 bg-orange-900/70"></div>
      </div>
      <div class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8 flex items-center min-h-[560px] md:min-h-[640px] pt-28 md:pt-[160px]">
        <div class="max-w-4xl text-white">
          <a href="/products" class="hero-badge inline-flex items-center gap-2 text-white/70 text-sm hover:text-white mb-6 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            All Products
          </a>
          <div class="inline-block bg-orange-500/30 border border-orange-400/40 text-orange-200 text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-4">WO & PO Module</div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 hero-title">Work Order & Purchase Order (ENFA) Management</h1>
          <p class="text-xl text-white/85 leading-relaxed hero-desc max-w-3xl">
            Issue, approve, track, and close work orders and purchase orders with complete accountability. ENFA-ready workflows so procurement moves at the speed your project demands.
          </p>
          <div class="hero-cta flex flex-wrap gap-4 mt-10">
            <a href="/about#request-demo" class="bg-white text-orange-900 font-semibold px-7 py-3 rounded-full hover:bg-orange-50 transition-colors">Book a Demo</a>
            <a href="/products/valency-360" class="border border-white/40 text-white font-semibold px-7 py-3 rounded-full hover:bg-white/10 transition-colors">See Full Suite</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Problem & Solution -->
    <section class="w-full bg-white py-16 md:py-24">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <div>
              <p class="text-sm font-semibold uppercase tracking-widest text-gray-400 mb-3">The Problem</p>
              <h2 class="text-3xl font-bold text-gray-900 mb-6">Orders Raised in Emails, Approvals in WhatsApp, Tracking Nowhere</h2>
              <p class="text-gray-600 leading-relaxed mb-6">
                Without a structured WO/PO system, subcontractor scope creep is invisible, procurement delays cascade into project delays, and invoice reconciliation becomes a monthly battle with no audit trail.
              </p>
              <ul class="space-y-3">
                {[
                  "Work orders issued verbally — no documented scope",
                  "Purchase orders raised without budget checks",
                  "No system to match POs against GRNs and invoices",
                  "Approval bottlenecks causing procurement delays",
                ].map(p => (
                  <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-5 h-5 rounded-full bg-red-100 flex items-center justify-center mt-0.5">
                      <svg class="w-3 h-3 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </span>
                    <span class="text-gray-600 text-sm">{p}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <p class="text-sm font-semibold uppercase tracking-widest text-gray-400 mb-3">The Solution</p>
              <h2 class="text-3xl font-bold text-gray-900 mb-6">Structured Procurement with Full ENFA Compliance</h2>
              <p class="text-gray-600 leading-relaxed mb-6">
                Valency's WO & PO module brings every order into a single structured workflow — from creation through multi-level approval to closure. ENFA-ready with complete audit trails and seamless links to materials, billing, and site progress.
              </p>
              <ul class="space-y-3">
                {[
                  "Every work order has defined scope, value, and timeline",
                  "POs linked to approved indents and budget lines",
                  "Three-way matching: PO vs GRN vs invoice",
                  "Configurable approval workflows by value or category",
                ].map(s => (
                  <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-5 h-5 rounded-full bg-orange-100 flex items-center justify-center mt-0.5">
                      <svg class="w-3 h-3 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                    </span>
                    <span class="text-gray-600 text-sm">{s}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="w-full bg-gray-50 py-16 md:py-24">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto">
          <div class="text-center mb-14">
            <p class="text-sm font-semibold uppercase tracking-widest text-gray-500 mb-3">Features</p>
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900">Every Order, Every Approval, Every Rupee — Accounted For</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {[
              { icon: "📝", title: "Work Order Creation", desc: "Issue work orders to subcontractors with defined scope, rate, quantities, and completion milestones. All parties get digital acknowledgement." },
              { icon: "🛒", title: "Purchase Order Management", desc: "Raise POs linked to material indents and budget lines. Vendor details, delivery schedules, and terms captured at order stage." },
              { icon: "✅", title: "Multi-Level Approval Workflows", desc: "Configure approval chains by order value, category, or department. Approvers notified instantly via app. No paper shuffling." },
              { icon: "🔗", title: "ENFA Integration", desc: "Fully ENFA-compliant workflows for engineering, notification, and field activity management. Standard formats supported." },
              { icon: "🔄", title: "Three-Way Matching", desc: "Automatically match Purchase Order → Goods Receipt Note → Supplier Invoice to prevent overpayment and duplicate billing." },
              { icon: "📊", title: "PO vs Actual Tracking", desc: "Compare ordered quantities and values against actual receipts and consumption. Identify under-delivery or excess billing instantly." },
              { icon: "📋", title: "Subcontractor WO Billing", desc: "Work order completion percentages feed directly into subcontractor billing — no separate billing sheets required." },
              { icon: "🔔", title: "Expiry & Renewal Alerts", desc: "Get notified on work orders nearing completion dates, POs not yet delivered, or budget commitments approaching limits." },
              { icon: "📁", title: "Document Attachment", desc: "Attach scope documents, drawings, BOQ extracts, and correspondence directly to each WO or PO for a complete record." },
            ].map(f => (
              <div class="bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">{f.icon}</div>
                <h3 class="text-base font-bold text-gray-900 mb-2">{f.title}</h3>
                <p class="text-gray-600 text-sm leading-relaxed">{f.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Workflow -->
    <section class="w-full bg-white py-16 md:py-20">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <p class="text-sm font-semibold uppercase tracking-widest text-gray-500 mb-3">Order Lifecycle</p>
            <h2 class="text-3xl font-bold text-gray-900">From Requirement to Closure in 5 Steps</h2>
          </div>
          <div class="relative">
            <div class="absolute left-6 top-0 bottom-0 w-0.5 bg-gray-200 hidden md:block"></div>
            <div class="space-y-10">
              {[
                { step: "1", title: "Requirement Identified", desc: "Site team raises a material indent or a new work package requirement — triggering the WO or PO process." },
                { step: "2", title: "Order Created & Submitted", desc: "Procurement or site team creates the WO/PO with full details: scope, quantities, rates, vendor, and timeline. Submitted for approval." },
                { step: "3", title: "Approval Workflow", desc: "Configurable approvers (by value threshold or category) review and approve via mobile or web. Rejected orders returned with comments." },
                { step: "4", title: "Execution & GRN / Progress", desc: "For POs — material received and GRN raised. For WOs — site progress recorded against milestones. Both linked back to the order." },
                { step: "5", title: "Invoice Matching & Closure", desc: "Vendor or subcontractor invoice is matched against the order and execution records. Approved invoices trigger payment processing. Order closed." },
              ].map(s => (
                <div class="flex gap-6">
                  <div class="flex-shrink-0 w-12 h-12 bg-orange-500 rounded-full flex items-center justify-center text-white font-bold text-lg z-10">{s.step}</div>
                  <div class="pt-2">
                    <h3 class="text-lg font-bold text-gray-900 mb-1">{s.title}</h3>
                    <p class="text-gray-600 text-sm leading-relaxed">{s.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="w-full bg-orange-600 py-14 md:py-20">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Procurement without the chaos.</h2>
        <p class="text-orange-100 text-lg mb-8 max-w-xl mx-auto">See how Valency's WO & PO module brings order and accountability to your procurement process.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/about#request-demo" class="bg-white text-orange-700 font-semibold px-8 py-3 rounded-full hover:bg-orange-50 transition-colors">Book a Demo</a>
          <a href="/products/valency-360" class="border border-white/40 text-white font-semibold px-8 py-3 rounded-full hover:bg-white/10 transition-colors">Explore Valency 360</a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  .hero-bg { opacity:0; transform:scale(1.1); animation:bgFade 2.4s ease-out forwards; }
  .hero-badge { opacity:0; animation:fadeUp 1s ease-out forwards; animation-delay:0.3s; }
  .hero-title { opacity:0; transform:translateY(30px); animation:fadeUp 1.6s cubic-bezier(0.34,1.56,0.64,1) forwards; animation-delay:0.5s; }
  .hero-desc { opacity:0; transform:translateY(30px); animation:fadeUp 1.6s cubic-bezier(0.34,1.56,0.64,1) forwards; animation-delay:0.8s; }
  .hero-cta { opacity:0; transform:translateY(20px); animation:fadeUp 1.4s cubic-bezier(0.34,1.56,0.64,1) forwards; animation-delay:1.1s; }
  @keyframes bgFade { to { opacity:1; transform:scale(1); } }
  @keyframes fadeUp { to { opacity:1; transform:translateY(0); } }
</style>
