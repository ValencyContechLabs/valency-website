---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<Layout>
  <Header />
  <main class="bg-white">

    <!-- Hero -->
    <section class="relative w-full min-h-[560px] md:min-h-[640px] overflow-hidden -mt-20 md:-mt-24">
      <div class="absolute inset-0" style="top:-80px; height:calc(100% + 80px);">
        <img
          src="https://images.unsplash.com/photo-1581094794329-c8112a89af12?w=1920&h=1080&fit=crop"
          class="w-full h-full object-cover hero-bg"
          alt="QC Quality Check Management"
        />
        <div class="absolute inset-0 bg-rose-900/70"></div>
      </div>
      <div class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8 flex items-center min-h-[560px] md:min-h-[640px] pt-28 md:pt-[160px]">
        <div class="max-w-4xl text-white">
          <a href="/products" class="hero-badge inline-flex items-center gap-2 text-white/70 text-sm hover:text-white mb-6 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            All Products
          </a>
          <div class="inline-block bg-rose-500/30 border border-rose-400/40 text-rose-200 text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-4">QC Module</div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 hero-title">QC (Quality Check) Management</h1>
          <p class="text-xl text-white/85 leading-relaxed hero-desc max-w-3xl">
            Build quality into every activity — not just at the end. Digital inspection checklists, NCR tracking, and photo documentation ensure your project meets spec at every stage.
          </p>
          <div class="hero-cta flex flex-wrap gap-4 mt-10">
            <a href="/about#request-demo" class="bg-white text-rose-900 font-semibold px-7 py-3 rounded-full hover:bg-rose-50 transition-colors">Book a Demo</a>
            <a href="/products/valency-360" class="border border-white/40 text-white font-semibold px-7 py-3 rounded-full hover:bg-white/10 transition-colors">See Full Suite</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Problem & Solution -->
    <section class="w-full bg-white py-16 md:py-24">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <div>
              <p class="text-sm font-semibold uppercase tracking-widest text-gray-400 mb-3">The Problem</p>
              <h2 class="text-3xl font-bold text-gray-900 mb-6">Quality Checks Happen on Paper — or Not at All</h2>
              <p class="text-gray-600 leading-relaxed mb-6">
                Without a structured QC system, defects are caught late (or not until client inspection), rework costs spiral, and there's no audit trail to protect your team in disputes. Paper-based inspection records get lost or go unactioned.
              </p>
              <ul class="space-y-3">
                {[
                  "Inspections skipped or done retrospectively",
                  "Defects discovered at handover — costly rework",
                  "NCRs raised on WhatsApp with no tracking",
                  "No photo evidence when disputes arise",
                ].map(p => (
                  <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-5 h-5 rounded-full bg-red-100 flex items-center justify-center mt-0.5">
                      <svg class="w-3 h-3 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </span>
                    <span class="text-gray-600 text-sm">{p}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <p class="text-sm font-semibold uppercase tracking-widest text-gray-400 mb-3">The Solution</p>
              <h2 class="text-3xl font-bold text-gray-900 mb-6">Digital Quality Control That Leaves No Room for Error</h2>
              <p class="text-gray-600 leading-relaxed mb-6">
                Valency's QC module digitalises every inspection with structured checklists linked to work activities. NCRs are raised, tracked, and closed in the system. Every inspection is timestamped, geotagged, and backed by photo evidence.
              </p>
              <ul class="space-y-3">
                {[
                  "Activity-specific checklists ensure nothing is missed",
                  "NCRs tracked from raise to closure with owner assigned",
                  "Photo and document evidence attached to every inspection",
                  "Management dashboard shows open quality issues in real time",
                ].map(s => (
                  <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-5 h-5 rounded-full bg-rose-100 flex items-center justify-center mt-0.5">
                      <svg class="w-3 h-3 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                    </span>
                    <span class="text-gray-600 text-sm">{s}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="w-full bg-gray-50 py-16 md:py-24">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto">
          <div class="text-center mb-14">
            <p class="text-sm font-semibold uppercase tracking-widest text-gray-500 mb-3">Features</p>
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900">Quality at Every Stage of Construction</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {[
              { icon: "✅", title: "Digital Inspection Checklists", desc: "Pre-configured or custom checklists for every work activity — concrete, masonry, waterproofing, MEP, and more. Site teams complete on mobile." },
              { icon: "📋", title: "Inspection Request & Schedule", desc: "Raise inspection requests for specific activities. QC team notified automatically. Inspection scheduled and tracked to completion." },
              { icon: "🚫", title: "NCR (Non-Conformance) Management", desc: "Raise NCRs with description, photos, and severity level. Assign to responsible party with due date. Track status until closure." },
              { icon: "📸", title: "Photo & Evidence Capture", desc: "Capture photos directly within the inspection or NCR. Time-stamped and geo-tagged. Irrefutable evidence for any dispute." },
              { icon: "🔧", title: "Defect & Punch List", desc: "Log defects at any stage. Generate a pre-handover punch list with status tracking. Ensure zero open defects at handover." },
              { icon: "🧪", title: "Test & Material Certificates", desc: "Record lab test results, material test certificates, and third-party inspection reports linked to specific work activities." },
              { icon: "📊", title: "QC Dashboard", desc: "Live view of inspection completion rates, open NCRs, overdue corrective actions, and quality trend by activity or contractor." },
              { icon: "🔔", title: "Quality Holds", desc: "Place a quality hold on any activity to prevent further work until an inspection or NCR is resolved. Hold lifted with approval." },
              { icon: "📄", title: "Quality Reports", desc: "Generate inspection summary reports, NCR reports, and quality registers in standard formats for client submission or internal audit." },
            ].map(f => (
              <div class="bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">{f.icon}</div>
                <h3 class="text-base font-bold text-gray-900 mb-2">{f.title}</h3>
                <p class="text-gray-600 text-sm leading-relaxed">{f.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- QC Workflow -->
    <section class="w-full bg-white py-16 md:py-20">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <p class="text-sm font-semibold uppercase tracking-widest text-gray-500 mb-3">Inspection Workflow</p>
            <h2 class="text-3xl font-bold text-gray-900">From Activity Completion to Quality Sign-Off</h2>
          </div>
          <div class="relative">
            <div class="absolute left-6 top-0 bottom-0 w-0.5 bg-gray-200 hidden md:block"></div>
            <div class="space-y-10">
              {[
                { step: "1", title: "Inspection Request Raised", desc: "When an activity reaches a quality hold point, site team raises an inspection request. QC team is notified instantly via app." },
                { step: "2", title: "Checklist Inspection Conducted", desc: "QC inspector conducts inspection using the digital checklist on mobile. Photos taken, observations noted, each checklist item marked pass/fail." },
                { step: "3", title: "NCR Raised if Required", desc: "Failed items automatically trigger an NCR with the responsible party assigned. Due date set for corrective action." },
                { step: "4", title: "Corrective Action & Re-inspection", desc: "Responsible party completes the fix and marks it done in the system. QC inspector conducts re-inspection to verify closure." },
                { step: "5", title: "Inspection Approved & Activity Released", desc: "Approved inspection releases the quality hold and allows the next activity to proceed. Full trail maintained in system." },
              ].map(s => (
                <div class="flex gap-6">
                  <div class="flex-shrink-0 w-12 h-12 bg-rose-600 rounded-full flex items-center justify-center text-white font-bold text-lg z-10">{s.step}</div>
                  <div class="pt-2">
                    <h3 class="text-lg font-bold text-gray-900 mb-1">{s.title}</h3>
                    <p class="text-gray-600 text-sm leading-relaxed">{s.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="w-full bg-rose-700 py-14 md:py-20">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Deliver projects that pass inspection — every time.</h2>
        <p class="text-rose-100 text-lg mb-8 max-w-xl mx-auto">See how Valency's QC module builds quality accountability into your team's daily workflow.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/about#request-demo" class="bg-white text-rose-700 font-semibold px-8 py-3 rounded-full hover:bg-rose-50 transition-colors">Book a Demo</a>
          <a href="/products/valency-360" class="border border-white/40 text-white font-semibold px-8 py-3 rounded-full hover:bg-white/10 transition-colors">Explore Valency 360</a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  .hero-bg { opacity:0; transform:scale(1.1); animation:bgFade 2.4s ease-out forwards; }
  .hero-badge { opacity:0; animation:fadeUp 1s ease-out forwards; animation-delay:0.3s; }
  .hero-title { opacity:0; transform:translateY(30px); animation:fadeUp 1.6s cubic-bezier(0.34,1.56,0.64,1) forwards; animation-delay:0.5s; }
  .hero-desc { opacity:0; transform:translateY(30px); animation:fadeUp 1.6s cubic-bezier(0.34,1.56,0.64,1) forwards; animation-delay:0.8s; }
  .hero-cta { opacity:0; transform:translateY(20px); animation:fadeUp 1.4s cubic-bezier(0.34,1.56,0.64,1) forwards; animation-delay:1.1s; }
  @keyframes bgFade { to { opacity:1; transform:scale(1); } }
  @keyframes fadeUp { to { opacity:1; transform:translateY(0); } }
</style>
