---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<Layout>
  <Header />
  <main class="bg-white">

    <!-- Hero -->
    <section class="relative w-full min-h-[560px] md:min-h-[640px] overflow-hidden -mt-20 md:-mt-24">
      <div class="absolute inset-0" style="top:-80px; height:calc(100% + 80px);">
        <img
          src="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=1920&h=1080&fit=crop"
          class="w-full h-full object-cover hero-bg"
          alt="BOQ and Document Management"
        />
        <div class="absolute inset-0 bg-violet-900/70"></div>
      </div>
      <div class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8 flex items-center min-h-[560px] md:min-h-[640px] pt-28 md:pt-[160px]">
        <div class="max-w-4xl text-white">
          <a href="/products" class="hero-badge inline-flex items-center gap-2 text-white/70 text-sm hover:text-white mb-6 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            All Products
          </a>
          <div class="inline-block bg-violet-500/30 border border-violet-400/40 text-violet-200 text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-4">BOQ & Documents Module</div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 hero-title">BOQ & Document Management</h1>
          <p class="text-xl text-white/85 leading-relaxed hero-desc max-w-3xl">
            Your project's single source of truth. Manage your Bill of Quantities, drawings, specifications, and project documents — with live progress tracking and automated billing from the same data.
          </p>
          <div class="hero-cta flex flex-wrap gap-4 mt-10">
            <a href="/about#request-demo" class="bg-white text-violet-900 font-semibold px-7 py-3 rounded-full hover:bg-violet-50 transition-colors">Book a Demo</a>
            <a href="/products/valency-360" class="border border-white/40 text-white font-semibold px-7 py-3 rounded-full hover:bg-white/10 transition-colors">See Full Suite</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Problem & Solution -->
    <section class="w-full bg-white py-16 md:py-24">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <div>
              <p class="text-sm font-semibold uppercase tracking-widest text-gray-400 mb-3">The Problem</p>
              <h2 class="text-3xl font-bold text-gray-900 mb-6">BOQs Live in Excel, Drawings on WhatsApp, Documents Everywhere</h2>
              <p class="text-gray-600 leading-relaxed mb-6">
                Without a centralised document system, teams work from the wrong drawing revision, billing teams recreate data from scratch, and variation orders get lost. Every version mismatch costs time and money.
              </p>
              <ul class="space-y-3">
                {[
                  "Multiple BOQ versions causing billing disputes",
                  "Outdated drawings used on site without knowing",
                  "Progress billing manually compiled each month",
                  "Variation orders tracked in email threads",
                ].map(p => (
                  <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-5 h-5 rounded-full bg-red-100 flex items-center justify-center mt-0.5">
                      <svg class="w-3 h-3 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </span>
                    <span class="text-gray-600 text-sm">{p}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <p class="text-sm font-semibold uppercase tracking-widest text-gray-400 mb-3">The Solution</p>
              <h2 class="text-3xl font-bold text-gray-900 mb-6">One Place for Every Project Document — Live and Version-Controlled</h2>
              <p class="text-gray-600 leading-relaxed mb-6">
                Valency's BOQ & Document Management module connects your quantities to your daily work. Progress is captured against BOQ line items, billing is generated automatically, and every document has a single controlled version.
              </p>
              <ul class="space-y-3">
                {[
                  "BOQ linked to daily activity progress for live tracking",
                  "Always-current drawing register with revision history",
                  "Progress billing generated in one click from site data",
                  "Variation orders tracked with full approval audit trail",
                ].map(s => (
                  <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-5 h-5 rounded-full bg-violet-100 flex items-center justify-center mt-0.5">
                      <svg class="w-3 h-3 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                    </span>
                    <span class="text-gray-600 text-sm">{s}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="w-full bg-gray-50 py-16 md:py-24">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto">
          <div class="text-center mb-14">
            <p class="text-sm font-semibold uppercase tracking-widest text-gray-500 mb-3">Features</p>
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900">From Quantities to Billing — Fully Connected</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {[
              { icon: "📋", title: "Bill of Quantities (BOQ)", desc: "Upload and manage your BOQ with hierarchical work packages, unit rates, and quantities. Link each item to on-site progress." },
              { icon: "📐", title: "Drawing Register", desc: "Centralised repository for all project drawings with revision control. Site teams always access the latest approved version." },
              { icon: "📈", title: "Progress Billing", desc: "Site progress against BOQ line items auto-generates interim payment certificates and billing claims — in the exact format required." },
              { icon: "🔄", title: "Variation Order Management", desc: "Raise, review, approve, and price variation orders with full workflow. Every VO linked to revised BOQ quantities and cost impact." },
              { icon: "📄", title: "Specification Management", desc: "Store and link material and workmanship specifications to relevant BOQ items so site teams always know the required standard." },
              { icon: "📁", title: "Document Version Control", desc: "Every document upload creates a new version. Previous versions are retained and accessible. No more 'which file is current?' confusion." },
              { icon: "🔍", title: "RFI Tracking", desc: "Raise and track Requests for Information against specific drawings or spec clauses. Response times and status visible to all parties." },
              { icon: "📊", title: "Cost vs Budget Dashboard", desc: "See BOQ budget vs committed costs vs actual spend in one view. Drill down to any work package at any time." },
              { icon: "📤", title: "Export & Reporting", desc: "Export billing claims, progress reports, and cost summaries in standard formats for client submission or internal review." },
            ].map(f => (
              <div class="bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">{f.icon}</div>
                <h3 class="text-base font-bold text-gray-900 mb-2">{f.title}</h3>
                <p class="text-gray-600 text-sm leading-relaxed">{f.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Billing Flow -->
    <section class="w-full bg-white py-16 md:py-20">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <p class="text-sm font-semibold uppercase tracking-widest text-gray-500 mb-3">Automated Billing Flow</p>
            <h2 class="text-3xl font-bold text-gray-900">From BOQ to Invoice in 4 Steps</h2>
          </div>
          <div class="relative">
            <div class="absolute left-6 top-0 bottom-0 w-0.5 bg-gray-200 hidden md:block"></div>
            <div class="space-y-10">
              {[
                { step: "1", title: "BOQ Setup", desc: "Import your BOQ or build it in Valency. Define work packages, line items, quantities, and unit rates." },
                { step: "2", title: "Daily Progress Capture", desc: "Site supervisors record daily work progress against BOQ line items via mobile. Quantities completed are logged in real time." },
                { step: "3", title: "Billing Compilation", desc: "At billing cut-off, the system aggregates all completed quantities and calculates the payable amount against each BOQ item automatically." },
                { step: "4", title: "Certificate Generation", desc: "An interim payment certificate or running account bill is generated in the required format — ready for client submission with no manual compilation." },
              ].map(s => (
                <div class="flex gap-6">
                  <div class="flex-shrink-0 w-12 h-12 bg-violet-600 rounded-full flex items-center justify-center text-white font-bold text-lg z-10">{s.step}</div>
                  <div class="pt-2">
                    <h3 class="text-lg font-bold text-gray-900 mb-1">{s.title}</h3>
                    <p class="text-gray-600 text-sm leading-relaxed">{s.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="w-full bg-violet-700 py-14 md:py-20">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Generate your next billing in minutes, not days.</h2>
        <p class="text-violet-100 text-lg mb-8 max-w-xl mx-auto">See how Valency's BOQ & Document module eliminates manual billing and version confusion on real projects.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/about#request-demo" class="bg-white text-violet-700 font-semibold px-8 py-3 rounded-full hover:bg-violet-50 transition-colors">Book a Demo</a>
          <a href="/products/valency-360" class="border border-white/40 text-white font-semibold px-8 py-3 rounded-full hover:bg-white/10 transition-colors">Explore Valency 360</a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  .hero-bg { opacity:0; transform:scale(1.1); animation:bgFade 2.4s ease-out forwards; }
  .hero-badge { opacity:0; animation:fadeUp 1s ease-out forwards; animation-delay:0.3s; }
  .hero-title { opacity:0; transform:translateY(30px); animation:fadeUp 1.6s cubic-bezier(0.34,1.56,0.64,1) forwards; animation-delay:0.5s; }
  .hero-desc { opacity:0; transform:translateY(30px); animation:fadeUp 1.6s cubic-bezier(0.34,1.56,0.64,1) forwards; animation-delay:0.8s; }
  .hero-cta { opacity:0; transform:translateY(20px); animation:fadeUp 1.4s cubic-bezier(0.34,1.56,0.64,1) forwards; animation-delay:1.1s; }
  @keyframes bgFade { to { opacity:1; transform:scale(1); } }
  @keyframes fadeUp { to { opacity:1; transform:translateY(0); } }
</style>
