---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FeatureIcon from "../../components/FeatureIcon.astro";
---

<Layout>
  <Header />
  <main class="bg-white">

    <!-- Hero -->
    <section class="relative w-full min-h-[560px] md:min-h-[640px] overflow-hidden -mt-20 md:-mt-24">
      <div class="absolute inset-0" style="top:-80px; height:calc(100% + 80px);">
        <img
          src="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=1920&h=1080&fit=crop"
          class="w-full h-full object-cover hero-bg"
          alt="Material Management"
        />
        <div class="absolute inset-0 bg-emerald-900/70"></div>
      </div>
      <div class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8 flex items-center min-h-[560px] md:min-h-[640px] pt-28 md:pt-[160px]">
        <div class="max-w-4xl text-white">
          <a href="/products" class="hero-badge inline-flex items-center gap-2 text-white/70 text-sm hover:text-white mb-6 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            All Products
          </a>
          <div class="inline-block bg-emerald-500/30 border border-emerald-400/40 text-emerald-200 text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-4">Material Module</div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 hero-title">Material Management</h1>
          <p class="text-xl text-white/85 leading-relaxed hero-desc max-w-3xl">
            Track every kilogram, litre, and unit from the moment it enters your site to where it's consumed. Eliminate wastage, prevent pilferage, and always know your material costs.
          </p>
          <div class="hero-cta flex flex-wrap gap-4 mt-10">
            <a href="/about#request-demo" class="bg-white text-emerald-900 font-semibold px-7 py-3 rounded-full hover:bg-emerald-50 transition-colors">Book a Demo</a>
            <a href="/products/valency-360" class="border border-white/40 text-white font-semibold px-7 py-3 rounded-full hover:bg-white/10 transition-colors">See Full Suite</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Problem & Solution -->
    <section class="w-full bg-white py-16 md:py-24">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <div>
              <p class="text-sm font-semibold uppercase tracking-widest text-gray-900 mb-3">The Problem</p>
              <h2 class="text-3xl font-bold text-gray-900 mb-6">Material Costs Are Spiralling — and Nobody Knows Why</h2>
              <p class="text-gray-600 leading-relaxed mb-6">
                Materials typically account for 50–60% of a construction project's cost. Yet most sites have no real-time view of stock levels, consumption, or wastage. By the time discrepancies surface, the budget is already blown.
              </p>
              <ul class="space-y-3">
                {[
                  "GRNs recorded days after delivery",
                  "No comparison between issued and consumed quantities",
                  "Wastage and pilferage go undetected",
                  "Material billing disputes with subcontractors",
                ].map(p => (
                  <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-5 h-5 rounded-full bg-red-100 flex items-center justify-center mt-0.5">
                      <svg class="w-3 h-3 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </span>
                    <span class="text-gray-600 text-sm">{p}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <p class="text-sm font-semibold uppercase tracking-widest text-gray-900 mb-3">The Solution</p>
              <h2 class="text-3xl font-bold text-gray-900 mb-6">Full Visibility from Indent to Consumption</h2>
              <p class="text-gray-600 leading-relaxed mb-6">
                Valency's Material Management module tracks every material transaction in real time — from the initial indent through delivery (GRN) to site-level consumption. Always know what you have, what you've used, and what it's cost.
              </p>
              <ul class="space-y-3">
                {[
                  "Real-time stock levels at each store location",
                  "Instant comparison: BOQ allocation vs actual usage",
                  "Automated wastage flagging beyond norms",
                  "Supplier-wise delivery and quality records",
                ].map(s => (
                  <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-5 h-5 rounded-full bg-emerald-100 flex items-center justify-center mt-0.5">
                      <svg class="w-3 h-3 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                    </span>
                    <span class="text-gray-600 text-sm">{s}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="w-full bg-gray-50 py-16 md:py-24">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto">
          <div class="text-center mb-14">
            <p class="text-sm font-semibold uppercase tracking-widest text-gray-500 mb-3">Features</p>
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900">Complete Control Over Every Material on Site</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {[
              { icon: "pencil-square", title: "Material Indent", desc: "Site teams raise digital indents for required materials. Requests routed to the right approver instantly with full audit trail." },
              { icon: "truck", title: "Goods Receipt Note (GRN)", desc: "Record deliveries on mobile at the gate. Quantity, quality checks, and supplier details captured before material enters store." },
              { icon: "cube", title: "Stock Ledger", desc: "Live stock register for each store location. View opening balance, receipts, issues, and closing stock in real time." },
              { icon: "wrench", title: "Material Issue to Work", desc: "Issue materials to specific activities or subcontractors with digital acknowledgements. No more unaccounted issues." },
              { icon: "trending-down", title: "Wastage & Reconciliation", desc: "Compare theoretical consumption against actual to identify wastage, spillage, or pilferage automatically." },
              { icon: "chart-bar", title: "BOQ vs Actual Comparison", desc: "See at a glance whether each material is within budget or over-consumed relative to BOQ allocations." },
              { icon: "arrow-path", title: "Material Return Management", desc: "Track materials returned from site to store or to vendors. Every transaction is logged and reconciled." },
              { icon: "building", title: "Supplier & Vendor Tracking", desc: "Maintain vendor records, rate contracts, and delivery performance history for every supplier." },
              { icon: "bell", title: "Low Stock Alerts", desc: "Set reorder thresholds. Get automated alerts when critical materials fall below minimum levels." },
            ].map(f => (
              <div class="bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-shadow">
                <div class="w-11 h-11 rounded-xl bg-emerald-50 border border-emerald-100 flex items-center justify-center mb-4"><FeatureIcon name={f.icon} class="w-6 h-6 text-emerald-700" /></div>
                <h3 class="text-base font-bold text-gray-900 mb-2">{f.title}</h3>
                <p class="text-gray-600 text-sm leading-relaxed">{f.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Lifecycle Flow -->
    <section class="w-full bg-white py-16 md:py-20">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <p class="text-sm font-semibold uppercase tracking-widest text-gray-500 mb-3">Material Lifecycle</p>
            <h2 class="text-3xl font-bold text-gray-900">End-to-End Tracking in 5 Stages</h2>
          </div>
          <div class="relative">
            <div class="absolute left-6 top-0 bottom-0 w-0.5 bg-gray-200 hidden md:block"></div>
            <div class="space-y-10">
              {[
                { step: "1", title: "Indent Raised", desc: "Site engineer raises a digital material requisition specifying quantity, grade, and required date. Routed for approval automatically." },
                { step: "2", title: "Purchase Order Issued", desc: "Approved indents trigger a purchase order (linked to the Work Order & PO module) to the selected vendor." },
                { step: "3", title: "GRN at Gate", desc: "On delivery, store keeper captures receipt via mobile — quantity, quality inspection result, and delivery challan details." },
                { step: "4", title: "Issue to Work", desc: "Materials are issued to activities or subcontractors from store with a digital issue slip. Consumption is recorded against BOQ line items." },
                { step: "5", title: "Reconciliation & Cost Report", desc: "The system reconciles received vs issued vs consumed and generates material cost reports per activity, per subcontractor, and per project." },
              ].map(s => (
                <div class="flex gap-6">
                  <div class="flex-shrink-0 w-12 h-12 bg-emerald-600 rounded-full flex items-center justify-center text-white font-bold text-lg z-10">{s.step}</div>
                  <div class="pt-2">
                    <h3 class="text-lg font-bold text-gray-900 mb-1">{s.title}</h3>
                    <p class="text-gray-600 text-sm leading-relaxed">{s.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="w-full bg-emerald-700 py-14 md:py-20">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Know exactly where every material goes.</h2>
        <p class="text-emerald-100 text-lg mb-8 max-w-xl mx-auto">See a live demo of Valency's Material Management module and stop budget overruns before they happen.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/about#request-demo" class="bg-white text-emerald-700 font-semibold px-8 py-3 rounded-full hover:bg-emerald-50 transition-colors">Book a Demo</a>
          <a href="/products/valency-360" class="border border-white/40 text-white font-semibold px-8 py-3 rounded-full hover:bg-white/10 transition-colors">Explore Valency 360</a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  .hero-bg { opacity:0; transform:scale(1.1); animation:bgFade 2.4s ease-out forwards; }
  .hero-badge { opacity:0; animation:fadeUp 1s ease-out forwards; animation-delay:0.3s; }
  .hero-title { opacity:0; transform:translateY(30px); animation:fadeUp 1.6s cubic-bezier(0.34,1.56,0.64,1) forwards; animation-delay:0.5s; }
  .hero-desc { opacity:0; transform:translateY(30px); animation:fadeUp 1.6s cubic-bezier(0.34,1.56,0.64,1) forwards; animation-delay:0.8s; }
  .hero-cta { opacity:0; transform:translateY(20px); animation:fadeUp 1.4s cubic-bezier(0.34,1.56,0.64,1) forwards; animation-delay:1.1s; }
  @keyframes bgFade { to { opacity:1; transform:scale(1); } }
  @keyframes fadeUp { to { opacity:1; transform:translateY(0); } }
</style>
