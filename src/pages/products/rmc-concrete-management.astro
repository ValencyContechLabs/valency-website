---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FeatureIcon from "../../components/FeatureIcon.astro";
---

<Layout
  title="RMC Concrete Management | Valency"
  description="One platform for the concrete supply chain — from the request raised on site to the mixer dispatched, and from material inward to consumption."
>
  <Header />
  <main class="bg-white">

    <!-- Hero -->
    <section class="relative w-full min-h-[560px] md:min-h-[640px] overflow-hidden -mt-20 md:-mt-24">
      <div class="absolute inset-0" style="top:-80px; height:calc(100% + 80px);">
        <img
          src="https://images.unsplash.com/photo-1777793919120-d225e868bbd4?w=1920&h=1080&fit=crop"
          class="w-full h-full object-cover hero-bg"
          alt="RMC batching plant — silos and conveyor"
        />
        <!--
          Dark but readable: one left-weighted gradient (heavy behind the text,
          light over the plant) plus a slight cyan tint. Layering several near-opaque
          overlays hides the photo entirely, so keep this to two.
        -->
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-950/70 to-slate-950/40"></div>
        <div class="absolute inset-0 bg-cyan-950/15"></div>
      </div>
      <div class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8 flex items-center min-h-[560px] md:min-h-[640px] pt-28 md:pt-[160px]">
        <div class="max-w-4xl text-white">
          <a href="/products" class="hero-badge inline-flex items-center gap-2 text-white/70 text-sm hover:text-white mb-6 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            All Products
          </a>
          <div class="inline-block bg-cyan-500/30 border border-cyan-400/40 text-cyan-100 text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-4">RMC Module</div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 hero-title">RMC Concrete Management</h1>
          <p class="text-xl text-white/85 leading-relaxed hero-desc max-w-3xl">
            One platform for the concrete supply chain — from the request raised on site to the mixer dispatched, and from material inward to consumption.
          </p>
          <div class="hero-cta flex flex-wrap gap-4 mt-10">
            <a href="/about#request-demo" class="bg-white text-cyan-900 font-semibold px-7 py-3 rounded-full hover:bg-cyan-50 transition-colors">Book a Demo</a>
            <a href="/products/valency-360" class="border border-white/40 text-white font-semibold px-7 py-3 rounded-full hover:bg-white/10 transition-colors">See Full Suite</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Problem & Solution -->
    <section class="w-full bg-white py-16 md:py-24">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <div>
              <p class="text-sm font-semibold uppercase tracking-widest text-gray-900 mb-3">The Problem</p>
              <h2 class="text-3xl font-bold text-gray-900 mb-6">The Concrete Chain Runs on Phone Calls</h2>
              <p class="text-gray-600 leading-relaxed mb-6">
                Site raises a concrete requirement by phone, the plant schedules it on a whiteboard, and the mixer leaves without anyone on site knowing when it will arrive. By the time consumption is reconciled against material inward, the month is over.
              </p>
              <ul class="space-y-3">
                {[
                  "Concrete requests raised over calls with no record",
                  "No shared view of plant queue or pour status",
                  "Mixer dispatch and arrival tracked on paper",
                  "Material inward never reconciled against consumption",
                ].map(p => (
                  <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-5 h-5 rounded-full bg-red-100 flex items-center justify-center mt-0.5">
                      <svg class="w-3 h-3 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </span>
                    <span class="text-gray-600 text-sm">{p}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <p class="text-sm font-semibold uppercase tracking-widest text-gray-900 mb-3">The Solution</p>
              <h2 class="text-3xl font-bold text-gray-900 mb-6">One Shared View of Every Plant, Queue and Pour</h2>
              <p class="text-gray-600 leading-relaxed mb-6">
                Valency's RMC module connects site, plant, and stores on a single live dashboard. Every request, dispatch, inward entry, and pour is captured once and visible to everyone who needs it — as it happens.
              </p>
              <ul class="space-y-3">
                {[
                  "Digital concrete request raised directly from site",
                  "Live plant status: running, waiting, on hold, critical",
                  "Mixer dispatch tracked from plant to pour",
                  "Plant stock and consumption reconciled automatically",
                ].map(s => (
                  <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-5 h-5 rounded-full bg-cyan-100 flex items-center justify-center mt-0.5">
                      <svg class="w-3 h-3 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                    </span>
                    <span class="text-gray-600 text-sm">{s}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="w-full bg-gray-50 py-16 md:py-24">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto">
          <div class="text-center mb-14">
            <p class="text-sm font-semibold uppercase tracking-widest text-gray-500 mb-3">Features</p>
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900">Built for the Whole Concrete Supply Chain</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {[
              { title: "Site Concrete Request", icon: "device-phone", desc: "Site teams raise a concrete requirement digitally — grade, quantity, location, and required time. Routed to the plant instantly with a full record." },
              { title: "Plant Allocation", icon: "building", desc: "Assign each request to the right plant based on capacity and queue. Every plant carries a named owner so accountability is never ambiguous." },
              { title: "Live Plant Dashboard", icon: "chart-bar", desc: "One shared view of every plant and its current state — running, waiting, on hold, or critical — updated as the day progresses." },
              { title: "Mixer Dispatch Tracking", icon: "truck", desc: "Track each mixer from the moment it is dispatched at the plant to arrival at the pour location. Site always knows what is on the way." },
              { title: "Pour Status", icon: "clipboard-list", desc: "Follow every pour through its lifecycle — planned, dispatched, running, and completed — with live counts across the project." },
              { title: "Material Inward", icon: "download", desc: "Record cement, aggregate, sand, and admixture inward at the plant. Every receipt updates plant stock the moment it is entered." },
              { title: "Stock & Consumption", icon: "chart-pie", desc: "Cluster-wise stock and plant consumption tracked material by material, with today's usage and running totals side by side." },
              { title: "Consumption Reconciliation", icon: "scale", desc: "Reconcile what came in against what was consumed per plant, so variance surfaces during the month rather than after it." },
              { title: "Critical & Hold Alerts", icon: "bell", desc: "Plants that go on hold or hit a critical stock level are flagged on the dashboard immediately, before a pour gets stopped." },
            ].map(f => (
              <div class="bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-shadow">
                <div class="w-11 h-11 rounded-xl bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-4">
                  <FeatureIcon name={f.icon} class="w-6 h-6 text-cyan-700" />
                </div>
                <h3 class="text-base font-bold text-gray-900 mb-2">{f.title}</h3>
                <p class="text-gray-600 text-sm leading-relaxed">{f.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Lifecycle Flow -->
    <section class="w-full bg-white py-16 md:py-20">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <p class="text-sm font-semibold uppercase tracking-widest text-gray-500 mb-3">Concrete Lifecycle</p>
            <h2 class="text-3xl font-bold text-gray-900">From Request to Consumption in 5 Stages</h2>
          </div>
          <div class="relative">
            <div class="absolute left-6 top-0 bottom-0 w-0.5 bg-gray-200 hidden md:block"></div>
            <div class="space-y-10">
              {[
                { step: "1", title: "Request Raised on Site", desc: "The site engineer raises a concrete request specifying grade, quantity, pour location, and the time it is needed." },
                { step: "2", title: "Plant Allocation & Queue", desc: "The request is allocated to a plant and enters its queue. The live dashboard shows where it sits against everything else scheduled that day." },
                { step: "3", title: "Mixer Dispatched", desc: "The plant dispatches a mixer against the request. Dispatch is recorded at source, so site can see what has left and what is still pending." },
                { step: "4", title: "Pour Completed", desc: "The pour is marked complete on site. Planned, dispatched, running, and completed counts update across the project in real time." },
                { step: "5", title: "Inward vs Consumption Reconciled", desc: "Material inward at the plant is reconciled against consumption for the period, giving a clear picture of stock and variance per plant." },
              ].map(s => (
                <div class="flex gap-6">
                  <div class="flex-shrink-0 w-12 h-12 bg-cyan-600 rounded-full flex items-center justify-center text-white font-bold text-lg z-10">{s.step}</div>
                  <div class="pt-2">
                    <h3 class="text-lg font-bold text-gray-900 mb-1">{s.title}</h3>
                    <p class="text-gray-600 text-sm leading-relaxed">{s.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="w-full bg-cyan-700 py-14 md:py-20">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Every plant, queue and pour on one screen.</h2>
        <p class="text-cyan-100 text-lg mb-8 max-w-xl mx-auto">See a live demo of Valency's RMC Concrete Management module and connect your site, plant, and stores.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/about#request-demo" class="bg-white text-cyan-700 font-semibold px-8 py-3 rounded-full hover:bg-cyan-50 transition-colors">Book a Demo</a>
          <a href="/products/valency-360" class="border border-white/40 text-white font-semibold px-8 py-3 rounded-full hover:bg-white/10 transition-colors">Explore Valency 360</a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  .hero-bg { opacity:0; transform:scale(1.1); animation:bgFade 2.4s ease-out forwards; }
  .hero-badge { opacity:0; animation:fadeUp 1s ease-out forwards; animation-delay:0.3s; }
  .hero-title { opacity:0; transform:translateY(30px); animation:fadeUp 1.6s cubic-bezier(0.34,1.56,0.64,1) forwards; animation-delay:0.5s; }
  .hero-desc { opacity:0; transform:translateY(30px); animation:fadeUp 1.6s cubic-bezier(0.34,1.56,0.64,1) forwards; animation-delay:0.8s; }
  .hero-cta { opacity:0; transform:translateY(20px); animation:fadeUp 1.4s cubic-bezier(0.34,1.56,0.64,1) forwards; animation-delay:1.1s; }
  @keyframes bgFade { to { opacity:1; transform:scale(1); } }
  @keyframes fadeUp { to { opacity:1; transform:translateY(0); } }
</style>
