---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FeatureIcon from "../../components/FeatureIcon.astro";
---

<Layout>
  <Header />
  <main class="bg-white">

    <!-- Hero -->
    <section class="relative w-full min-h-[560px] md:min-h-[640px] overflow-hidden -mt-20 md:-mt-24">
      <div class="absolute inset-0" style="top:-80px; height:calc(100% + 80px);">
        <img
          src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=1920&h=1080&fit=crop"
          class="w-full h-full object-cover hero-bg"
          alt="Machine Management"
        />
        <div class="absolute inset-0 bg-slate-900/70"></div>
      </div>
      <div class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8 flex items-center min-h-[560px] md:min-h-[640px] pt-28 md:pt-[160px]">
        <div class="max-w-4xl text-white">
          <a href="/products" class="hero-badge inline-flex items-center gap-2 text-white/70 text-sm hover:text-white mb-6 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            All Products
          </a>
          <div class="inline-block bg-slate-500/30 border border-slate-400/40 text-slate-200 text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-4">Machine Module</div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 hero-title">Machine Management</h1>
          <p class="text-xl text-white/85 leading-relaxed hero-desc max-w-3xl">
            Every hour your machine sits idle costs money. Track utilisation, fuel, maintenance, and operator performance — and allocate equipment costs accurately to the activities where they belong.
          </p>
          <div class="hero-cta flex flex-wrap gap-4 mt-10">
            <a href="/about#request-demo" class="bg-white text-slate-900 font-semibold px-7 py-3 rounded-full hover:bg-slate-100 transition-colors">Book a Demo</a>
            <a href="/products/valency-360" class="border border-white/40 text-white font-semibold px-7 py-3 rounded-full hover:bg-white/10 transition-colors">See Full Suite</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Problem & Solution -->
    <section class="w-full bg-white py-16 md:py-24">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <div>
              <p class="text-sm font-semibold uppercase tracking-widest text-gray-900 mb-3">The Problem</p>
              <h2 class="text-3xl font-bold text-gray-900 mb-6">Equipment Costs Are a Black Box on Most Sites</h2>
              <p class="text-gray-600 leading-relaxed mb-6">
                Heavy machinery is one of the most expensive line items in a project budget. Yet most sites have no real-time view of utilisation, fuel consumption, or which activities machines are being used for. Hire charges accumulate with no accountability.
              </p>
              <ul class="space-y-3">
                {[
                  "Machine hours logged manually — if at all",
                  "Fuel receipts unreconciled against usage",
                  "Idle time hidden in operator logs",
                  "Equipment costs not allocated to activities",
                ].map(p => (
                  <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-5 h-5 rounded-full bg-red-100 flex items-center justify-center mt-0.5">
                      <svg class="w-3 h-3 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </span>
                    <span class="text-gray-600 text-sm">{p}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <p class="text-sm font-semibold uppercase tracking-widest text-gray-900 mb-3">The Solution</p>
              <h2 class="text-3xl font-bold text-gray-900 mb-6">Full Visibility Into Every Machine on Your Site</h2>
              <p class="text-gray-600 leading-relaxed mb-6">
                Valency's Machine Management module gives you a real-time view of every piece of equipment — what it's doing, who's operating it, how much fuel it's consuming, and what it's costing. Maintenance schedules keep downtime planned, not unplanned.
              </p>
              <ul class="space-y-3">
                {[
                  "Daily hour logs recorded by operator on mobile",
                  "Fuel issues from store linked to machine records",
                  "Idle time vs productive time broken down by shift",
                  "Costs allocated to specific activities automatically",
                ].map(s => (
                  <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-5 h-5 rounded-full bg-slate-200 flex items-center justify-center mt-0.5">
                      <svg class="w-3 h-3 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                    </span>
                    <span class="text-gray-600 text-sm">{s}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="w-full bg-gray-50 py-16 md:py-24">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto">
          <div class="text-center mb-14">
            <p class="text-sm font-semibold uppercase tracking-widest text-gray-500 mb-3">Features</p>
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900">Take Command of Your Equipment Fleet</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {[
              { icon: "clock", title: "Hour Log & Utilisation", desc: "Operators log start and stop times by activity each shift. Productive hours, standby hours, and idle time tracked automatically." },
              { icon: "fuel", title: "Fuel Consumption Tracking", desc: "Fuel issues recorded against specific machines. Litres per hour benchmarked against norms. Over-consumption flagged immediately." },
              { icon: "users", title: "Operator Assignment", desc: "Assign operators to machines by shift. Track operator-wise productivity and machine handling records over time." },
              { icon: "wrench", title: "Maintenance Scheduling", desc: "Set periodic service intervals (by hours or date). Get alerts before scheduled maintenance is due. Log completed maintenance with records." },
              { icon: "chart-bar", title: "Activity-Wise Cost Allocation", desc: "Machine hours logged against activities automatically calculate equipment cost per activity — feeding into project cost reports." },
              { icon: "warning", title: "Breakdown & Downtime Logging", desc: "Log breakdowns with cause and duration. Track downtime by machine over the project. Identify chronic failure patterns." },
              { icon: "clipboard-list", title: "Hire vs Own Tracking", desc: "Manage both owned and hired equipment. Track hire periods, rates, and cost-per-hour. Compare against own equipment economics." },
              { icon: "trending-up", title: "Fleet Performance Dashboard", desc: "See all machines in one view — utilisation %, fuel efficiency, maintenance status, and cost-to-date for each piece of equipment." },
              { icon: "bell", title: "Alerts & Notifications", desc: "Alerts for machines approaching service intervals, excessive idle time, or fuel consumption deviating from norms." },
            ].map(f => (
              <div class="bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-shadow">
                <div class="w-11 h-11 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center mb-4"><FeatureIcon name={f.icon} class="w-6 h-6 text-slate-700" /></div>
                <h3 class="text-base font-bold text-gray-900 mb-2">{f.title}</h3>
                <p class="text-gray-600 text-sm leading-relaxed">{f.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Daily Workflow -->
    <section class="w-full bg-white py-16 md:py-20">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <p class="text-sm font-semibold uppercase tracking-widest text-gray-500 mb-3">Daily Workflow</p>
            <h2 class="text-3xl font-bold text-gray-900">How Machine Tracking Works Each Day</h2>
          </div>
          <div class="relative">
            <div class="absolute left-6 top-0 bottom-0 w-0.5 bg-gray-200 hidden md:block"></div>
            <div class="space-y-10">
              {[
                { step: "1", title: "Shift Start Log", desc: "Operator opens the Valency app, selects their machine, and logs shift start with meter reading. Activity and location captured." },
                { step: "2", title: "Activity Assignment", desc: "Supervisor assigns or operator selects the activity the machine will work on for the shift. Each activity tracked separately." },
                { step: "3", title: "Fuel Issue Record", desc: "When fuel is issued from store, the storekeeper logs it against the machine in real time. Quantity and cumulative consumption updated." },
                { step: "4", title: "Shift End & Breakdown Report", desc: "Operator logs shift end with final meter reading. Any breakdowns or stoppages recorded with cause and duration." },
                { step: "5", title: "Cost Allocation & Report", desc: "System calculates cost per machine per activity based on hours logged and applicable rate. Updates project cost dashboard overnight." },
              ].map(s => (
                <div class="flex gap-6">
                  <div class="flex-shrink-0 w-12 h-12 bg-slate-700 rounded-full flex items-center justify-center text-white font-bold text-lg z-10">{s.step}</div>
                  <div class="pt-2">
                    <h3 class="text-lg font-bold text-gray-900 mb-1">{s.title}</h3>
                    <p class="text-gray-600 text-sm leading-relaxed">{s.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="w-full bg-slate-800 py-14 md:py-20">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Stop paying for idle machines you can't see.</h2>
        <p class="text-slate-300 text-lg mb-8 max-w-xl mx-auto">See how Valency's Machine Management module brings full accountability to your equipment fleet.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/about#request-demo" class="bg-white text-slate-800 font-semibold px-8 py-3 rounded-full hover:bg-gray-100 transition-colors">Book a Demo</a>
          <a href="/products/valency-360" class="border border-white/40 text-white font-semibold px-8 py-3 rounded-full hover:bg-white/10 transition-colors">Explore Valency 360</a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  .hero-bg { opacity:0; transform:scale(1.1); animation:bgFade 2.4s ease-out forwards; }
  .hero-badge { opacity:0; animation:fadeUp 1s ease-out forwards; animation-delay:0.3s; }
  .hero-title { opacity:0; transform:translateY(30px); animation:fadeUp 1.6s cubic-bezier(0.34,1.56,0.64,1) forwards; animation-delay:0.5s; }
  .hero-desc { opacity:0; transform:translateY(30px); animation:fadeUp 1.6s cubic-bezier(0.34,1.56,0.64,1) forwards; animation-delay:0.8s; }
  .hero-cta { opacity:0; transform:translateY(20px); animation:fadeUp 1.4s cubic-bezier(0.34,1.56,0.64,1) forwards; animation-delay:1.1s; }
  @keyframes bgFade { to { opacity:1; transform:scale(1); } }
  @keyframes fadeUp { to { opacity:1; transform:translateY(0); } }
</style>
