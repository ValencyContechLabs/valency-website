---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HowItWorks from "../components/HowItWorks.astro";
---

<Layout>
  <Header />
  <main class="bg-white">
    <!-- Hero Section -->
    <section id="how-it-works-hero" class="relative w-full min-h-[500px] md:min-h-[600px] overflow-hidden mb-16 -mt-20 md:-mt-24">
      <!-- Background Image with Overlay - extends to top -->
      <div class="absolute how-it-works-hero-bg-container how-it-works-hero-bg-extended">
        <img 
          src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=1920&h=1080&fit=crop" 
          class="w-full h-full object-cover how-it-works-hero-bg-image"
          alt="How It Works - Construction Process"
        />
        <div class="absolute inset-0 bg-black/50"></div>
      </div>

      <!-- Content - starts below header -->
      <div class="relative z-10 container mx-auto px-2 sm:px-4 lg:px-6 h-full flex items-center min-h-[500px] md:min-h-[600px] pt-24 md:pt-[150px]">
        <div class="max-w-4xl text-white">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 how-it-works-hero-title">
            How It Works
          </h1>
          <p class="text-xl md:text-2xl text-white/90 leading-relaxed how-it-works-hero-description">
            From BOQ to Billing — Discover our fully automated construction management process that transforms how you track, execute, and deliver projects.
          </p>
        </div>
      </div>
    </section>

    <HowItWorks />
  </main>
  <Footer />
</Layout>

<style>
  /* How It Works Hero Background extends to top */
  .how-it-works-hero-bg-extended {
    top: -80px;
    left: 0;
    right: 0;
    height: calc(100% + 80px);
  }

  /* How It Works Hero Section Animations */
  .how-it-works-hero-bg-image {
    opacity: 0;
    transform: scale(1.1);
    animation: howItWorksHeroBgFadeIn 2.4s ease-out forwards;
  }

  @keyframes howItWorksHeroBgFadeIn {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .how-it-works-hero-title {
    opacity: 0;
    transform: translateY(30px);
    animation: howItWorksHeroFadeIn 1.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: 0.6s;
  }

  .how-it-works-hero-description {
    opacity: 0;
    transform: translateY(30px);
    animation: howItWorksHeroFadeIn 1.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: 1s;
  }

  @keyframes howItWorksHeroFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

