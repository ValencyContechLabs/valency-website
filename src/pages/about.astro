---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Header />
  <main class="bg-white">
    <!-- Hero Section -->
    <section id="about-hero" class="relative w-full min-h-[500px] md:min-h-[600px] overflow-hidden mb-16 -mt-20 md:-mt-24">
      <!-- Background Image with Overlay - extends to top -->
      <div class="absolute about-hero-bg-container about-hero-bg-extended">
        <img 
          src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1920&h=1080&fit=crop" 
          class="w-full h-full object-cover about-hero-bg-image"
          alt="About Valency"
        />
        <div class="absolute inset-0 bg-black/50"></div>
      </div>

      <!-- Content - starts below header -->
      <div class="relative z-10 container mx-auto px-2 sm:px-4 lg:px-6 h-full flex items-center min-h-[500px] md:min-h-[600px] pt-24 md:pt-[150px]">
        <div class="max-w-4xl text-white">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 about-hero-title">
            About Us
          </h1>
          <p class="text-xl md:text-2xl text-white/90 leading-relaxed about-hero-description">
            At Valency, we combine deep expertise in construction management and cutting-edge technology to deliver exceptional results.
          </p>
        </div>
      </div>
    </section>

    <!-- About Content Section -->
    <section class="w-full bg-white pb-10 md:pb-16">
      <div class="container mx-auto px-2 sm:px-4 lg:px-6">
        <div class="max-w-4xl mx-auto">
          <div class="prose prose-lg max-w-none">
            <p class="text-gray-700 text-lg leading-relaxed mb-6">
              With over a decade of experience in the industry, our team blends civil engineering knowledge with innovative software solutions to ensure that every project is executed to the highest standards. Whether you're undertaking a residential, commercial, or industrial construction project, we offer integrated solutions that streamline the entire process, boost efficiency, and enhance overall project outcomes.
            </p>
            <p class="text-gray-700 text-lg leading-relaxed">
              Our approach integrates proven construction management practices with the latest technological tools, empowering us to address complex challenges and achieve successful project completion. From initial planning to final handover, our team works closely with you to turn your vision into reality, ensuring full control over timelines, costs, and quality.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Request a Demo Section -->
    <section id="request-demo" class="relative w-full py-16 md:py-24 overflow-hidden">
      <!-- Background Image -->
      <div class="absolute inset-0 demo-bg-container">
        <img 
          src="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=1920&h=1080&fit=crop" 
          class="w-full h-full object-cover demo-bg-image"
          alt="Request Demo Background"
        />
        <div class="absolute inset-0 bg-black/40"></div>
      </div>

      <div class="relative z-10 container mx-auto px-2 sm:px-4 lg:px-6">
        <div class="max-w-7xl mx-auto">
          <!-- Header -->
          <div class="text-center mb-12 demo-section-header">
            <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
              Request a Demo
            </h2>
            <p class="text-white/90 text-lg max-w-2xl mx-auto">
              Talk to a Valency expert about your requirements, technology stack, and timeline. Complete the form and we'll make sure to reach out.
            </p>
          </div>

          <!-- Two Column Layout -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
            <!-- Left: Form -->
            <div class="bg-white/95 backdrop-blur-sm rounded-xl p-8 shadow-lg demo-form-container">
              <form id="demo-request-form" class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label for="firstName" class="block text-sm font-medium text-gray-700 mb-2">First Name</label>
                    <input 
                      type="text" 
                      id="firstName" 
                      name="firstName"
                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                      placeholder="Enter your first name"
                    />
                  </div>
                  <div>
                    <label for="lastName" class="block text-sm font-medium text-gray-700 mb-2">Last Name</label>
                    <input 
                      type="text" 
                      id="lastName" 
                      name="lastName"
                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                      placeholder="Enter your last name"
                    />
                  </div>
                </div>

                <div>
                  <label for="email" class="block text-sm font-medium text-gray-700 mb-2">Work Email</label>
                  <input 
                    type="email" 
                    id="email" 
                    name="email"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    placeholder="name@company.com"
                  />
                </div>

                <div>
                  <label for="company" class="block text-sm font-medium text-gray-700 mb-2">Company</label>
                  <input 
                    type="text" 
                    id="company" 
                    name="company"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    placeholder="Enter your company name"
                  />
                </div>

                <div>
                  <label for="hearAbout" class="block text-sm font-medium text-gray-700 mb-2">How did you hear about us?</label>
                  <textarea 
                    id="hearAbout" 
                    name="hearAbout"
                    rows="3"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    placeholder="Enter your message"
                  ></textarea>
                </div>

                <div>
                  <label for="projectDetails" class="block text-sm font-medium text-gray-700 mb-2">Project Details or Questions</label>
                  <textarea 
                    id="projectDetails" 
                    name="projectDetails"
                    rows="4"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    placeholder="Share your requirements"
                  ></textarea>
                </div>

                <div class="flex items-start">
                  <input 
                    type="checkbox" 
                    id="newsletter" 
                    name="newsletter"
                    class="mt-1 mr-3 w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                    checked
                  />
                  <label for="newsletter" class="text-sm text-gray-700">
                    Yes, I'd like to receive news and updates by email.
                  </label>
                </div>

                <p class="text-sm text-gray-600">
                  By submitting this form you agree with our <a href="#" class="text-blue-600 hover:underline">Privacy Policy</a>.
                </p>

                <button 
                  type="submit"
                  id="submit-btn"
                  class="w-full bg-gray-900 hover:bg-gray-800 text-white font-semibold py-3 px-6 rounded-lg transition-colors duration-600 disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  Get started
                </button>
              </form>
              <div id="form-message" class="mt-4 hidden"></div>
            </div>

            <!-- Right: Features -->
            <div class="space-y-6 demo-features-container">
              <ul class="space-y-6">
                <li class="flex items-start gap-3 demo-feature-item" style="animation-delay: 0.2s;">
                  <span class="flex-shrink-0 w-2 h-2 bg-white rounded-full mt-2"></span>
                  <p class="text-white text-lg leading-relaxed">
                    <strong>Streamline Billing</strong> through one-click generation of accurate invoices directly from daily data.
                  </p>
                </li>
                <li class="flex items-start gap-3 demo-feature-item" style="animation-delay: 0.3s;">
                  <span class="flex-shrink-0 w-2 h-2 bg-white rounded-full mt-2"></span>
                  <p class="text-white text-lg leading-relaxed">
                    <strong>Provide Real-Time Project Insights</strong> for precise decision-making and rapid issue resolution.
                  </p>
                </li>
                <li class="flex items-start gap-3 demo-feature-item" style="animation-delay: 0.4s;">
                  <span class="flex-shrink-0 w-2 h-2 bg-white rounded-full mt-2"></span>
                  <p class="text-white text-lg leading-relaxed">
                    <strong>Offer Automated Projections</strong> to anticipate project timelines, costs, and resource requirements.
                  </p>
                </li>
                <li class="flex items-start gap-3 demo-feature-item" style="animation-delay: 0.5s;">
                  <span class="flex-shrink-0 w-2 h-2 bg-white rounded-full mt-2"></span>
                  <p class="text-white text-lg leading-relaxed">
                    <strong>Optimize Workforce and Productivity Tracking</strong> through detailed, activity-wise reports.
                  </p>
                </li>
                <li class="flex items-start gap-3 demo-feature-item" style="animation-delay: 0.6s;">
                  <span class="flex-shrink-0 w-2 h-2 bg-white rounded-full mt-2"></span>
                  <p class="text-white text-lg leading-relaxed">
                    <strong>Support Data-Driven Decisions</strong> with easy access to granular insights into project progress and costs.
                  </p>
                </li>
              </ul>

              <!-- Our Clients -->
              <!-- <div class="mt-12">
                <h4 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-6">OUR CLIENTS</h4>
                <div class="flex flex-wrap items-center gap-6 opacity-60">
                  <div class="text-2xl font-bold text-gray-700">Greenwood</div>
                </div>
              </div> -->
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  // Function to scroll to and focus on request-demo section
  function scrollToRequestDemo() {
    const demoSection = document.getElementById('request-demo');
    if (demoSection) {
      // Account for sticky header height
      const headerHeight = 64; // md:h-16 = 64px
      const elementPosition = demoSection.getBoundingClientRect().top + window.pageYOffset;
      const offsetPosition = elementPosition - headerHeight;

      window.scrollTo({
        top: offsetPosition,
        behavior: 'smooth'
      });

      // Focus on first input field after scroll
      setTimeout(() => {
        const firstNameInput = document.getElementById('firstName') as HTMLInputElement;
        if (firstNameInput) {
          firstNameInput.focus();
        }
      }, 600);
    }
  }

  // Handle hash navigation when page loads
  if (window.location.hash === '#request-demo') {
    setTimeout(scrollToRequestDemo, 100);
  }

  // Handle hash changes (e.g., when clicking link from same page)
  window.addEventListener('hashchange', () => {
    if (window.location.hash === '#request-demo') {
      scrollToRequestDemo();
    }
  });

  const form = document.getElementById('demo-request-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const messageDiv = document.getElementById('form-message') as HTMLDivElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Basic validation
      const emailInput = form.querySelector('#email') as HTMLInputElement;
      const firstNameInput = form.querySelector('#firstName') as HTMLInputElement;
      
      if (!firstNameInput?.value.trim()) {
        messageDiv.className = 'mt-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-800';
        messageDiv.textContent = 'Please enter your first name.';
        messageDiv.classList.remove('hidden');
        return;
      }
      
      if (!emailInput?.value.trim() || !emailInput.value.includes('@')) {
        messageDiv.className = 'mt-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-800';
        messageDiv.textContent = 'Please enter a valid email address.';
        messageDiv.classList.remove('hidden');
        return;
      }
      
      // Disable submit button
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
      messageDiv.classList.add('hidden');

      try {
        const formData = new FormData(form);
        
        const response = await fetch('/api/request-demo', {
          method: 'POST',
          body: formData,
        });

        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }

        const result = await response.json();

        if (result.success) {
          messageDiv.className = 'mt-4 p-4 bg-green-50 border border-green-200 rounded-lg text-green-800';
          messageDiv.textContent = result.message || 'Thank you! We will reach out to you soon.';
          messageDiv.classList.remove('hidden');
          form.reset();
        } else {
          messageDiv.className = 'mt-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-800';
          messageDiv.textContent = result.message || 'Something went wrong. Please try again.';
          messageDiv.classList.remove('hidden');
        }
      } catch (error) {
        console.error('Form submission error:', error);
        messageDiv.className = 'mt-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-800';
        messageDiv.textContent = `Error: ${error instanceof Error ? error.message : 'Network error. Please check your connection and try again.'}`;
        messageDiv.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Get started';
      }
    });
  }
</script>

<style>
  /* About Hero Background extends to top */
  .about-hero-bg-extended {
    top: -80px;
    left: 0;
    right: 0;
    height: calc(100% + 80px);
  }

  /* About Hero Section Animations */
  .about-hero-bg-image {
    opacity: 0;
    transform: scale(1.1);
    animation: aboutHeroBgFadeIn 2.4s ease-out forwards;
  }

  @keyframes aboutHeroBgFadeIn {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .about-hero-title {
    opacity: 0;
    transform: translateY(30px);
    animation: aboutHeroFadeIn 1.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: 0.6s;
  }

  .about-hero-description {
    opacity: 0;
    transform: translateY(30px);
    animation: aboutHeroFadeIn 1.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: 1s;
  }

  @keyframes aboutHeroFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Request Demo Background Image */
  .demo-bg-image {
    opacity: 0;
    transform: scale(1.1);
    animation: demoBgFadeIn 2s ease-out forwards;
  }

  @keyframes demoBgFadeIn {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Request Demo Section Animations */
  .demo-section-header {
    opacity: 0;
    transform: translateY(30px);
    animation: demoSectionFadeIn 1.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  .demo-form-container {
    opacity: 0;
    transform: translateX(-30px);
    animation: demoFormFadeIn 1.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: 0.4s;
  }

  .demo-features-container {
    opacity: 0;
    transform: translateX(30px);
    animation: demoFeaturesFadeIn 1.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: 0.6s;
  }

  .demo-feature-item {
    opacity: 0;
    transform: translateX(20px);
    animation: demoFeatureItemFadeIn 1.2s ease-out forwards;
  }

  @keyframes demoSectionFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes demoFormFadeIn {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes demoFeaturesFadeIn {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes demoFeatureItemFadeIn {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Trigger animations when section comes into view */
  #request-demo.animated .demo-section-header,
  #request-demo.animated .demo-form-container,
  #request-demo.animated .demo-features-container {
    animation-play-state: running;
  }

  /* Initial state for demo section */
  #request-demo {
    opacity: 1;
  }

  /* Intersection Observer will add 'animated' class */
  #request-demo:not(.animated) .demo-section-header,
  #request-demo:not(.animated) .demo-form-container,
  #request-demo:not(.animated) .demo-features-container,
  #request-demo:not(.animated) .demo-feature-item {
    opacity: 0;
  }
</style>

<script>
  // Animate request demo section when it comes into view
  const requestDemoSection = document.getElementById('request-demo');
  if (requestDemoSection) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animated');
          }
        });
      },
      { threshold: 0.1 }
    );
    observer.observe(requestDemoSection);
  }
</script>

