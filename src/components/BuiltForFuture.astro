---
---

<section id="built-for-future" class="w-full bg-white pb-10 md:pb-16">
	<div class="container mx-auto px-2 sm:px-4 lg:px-6">
		<div class="max-w-7xl mx-auto">
			<!-- Header Section -->
			<div class="text-center mb-12 built-future-header">
				<h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-4 built-future-title">
					Cost Optimization & Waste Reduction
				</h2>
				<p class="text-gray-600 text-lg max-w-3xl mx-auto built-future-subtitle">
					Our structured construction management approach focuses on eliminating inefficiencies and maximizing value across every phase of the project.
				</p>
			</div>

			<!-- Three Column Layout -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 built-future-content">
				<!-- Card 1: Current Industry Waste -->
				<div class="cost-card bg-gray-50 rounded-xl p-6 md:p-8 border-2 border-transparent">
					<h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-4">
						Current Industry Waste
					</h3>
					<p class="text-gray-600 text-base md:text-lg leading-relaxed">
						Industry studies indicate that 5–7% of project costs are typically lost due to billing errors, inaccurate material tracking, and labor headcount mismanagement.
					</p>
				</div>

				<!-- Card 2: Future Savings with Advanced Controls -->
				<div class="cost-card bg-gray-50 rounded-xl p-6 md:p-8 border-2 border-transparent">
					<h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-4">
						Future Savings with Advanced Controls
					</h3>
					<p class="text-gray-600 text-base md:text-lg leading-relaxed">
						With the introduction of enhanced material tracking and machinery management systems, we anticipate reducing wastage by an additional 5–6% through improved visibility, accountability, and utilization.
					</p>
				</div>

				<!-- Card 3: Total Project Cost Savings -->
				<div class="cost-card bg-gray-50 rounded-xl p-6 md:p-8 border-2 border-transparent">
					<h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-4">
						Total Project Cost Savings
					</h3>
					<p class="text-gray-600 text-base md:text-lg leading-relaxed">
						By combining process discipline with advanced digital tools, overall project wastage can be reduced from 10–12% down to just 1–3%, delivering up to 9% savings on total project costs.
					</p>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	const builtForFutureSection = document.getElementById('built-for-future');
	if (builtForFutureSection) {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('visible');
						
						// Animate header title
						const title = entry.target.querySelector('.built-future-title') as HTMLElement | null;
						if (title) {
							setTimeout(() => {
								title.style.opacity = '1';
								title.style.transform = 'translateY(0)';
							}, 100);
						}
						
						// Animate header subtitle
						const subtitle = entry.target.querySelector('.built-future-subtitle') as HTMLElement | null;
						if (subtitle) {
							setTimeout(() => {
								subtitle.style.opacity = '1';
								subtitle.style.transform = 'translateY(0)';
							}, 300);
						}
						
						// Animate content cards
						const content = entry.target.querySelector('.built-future-content') as HTMLElement | null;
						if (content) {
							content.style.opacity = '1';
							const cards = content.querySelectorAll('div > div');
							cards.forEach((card, index) => {
								setTimeout(() => {
									const htmlCard = card as HTMLElement;
									htmlCard.style.opacity = '1';
									htmlCard.style.transform = 'translateY(0)';
								}, 500 + index * 150);
							});
						}
					}
				});
			},
			{ threshold: 0.2 }
		);
		observer.observe(builtForFutureSection);
	}
</script>

<style>
	.built-future-title {
		opacity: 0;
		transform: translateY(30px);
		transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1), transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.built-future-subtitle {
		opacity: 0;
		transform: translateY(20px);
		transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1), transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.built-future-content {
		opacity: 0;
		transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1);
		transition-delay: 0.3s;
	}

	.built-future-content > div {
		opacity: 0;
		transform: translateY(30px);
		transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.cost-card {
		transition: background-color 0.5s cubic-bezier(0.4, 0, 0.2, 1),
		            box-shadow 0.5s cubic-bezier(0.4, 0, 0.2, 1),
		            border-color 0.5s cubic-bezier(0.4, 0, 0.2, 1),
		            transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
		cursor: pointer;
	}

	.cost-card:hover {
		background-color: #eff6ff;
		box-shadow: 0 20px 25px -5px rgba(59, 130, 246, 0.1), 0 10px 10px -5px rgba(59, 130, 246, 0.04);
		border-color: #bfdbfe;
		transform: translateY(-4px);
	}

</style>

