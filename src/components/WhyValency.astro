---
const features = [
	{
		title: 'Expert Team with Diverse Expertise',
		description: 'Highly skilled professionals with over 12 years of experience in civil engineering and software development, ensuring structural integrity and innovative project management tools.',
	},
	{
		title: 'Cutting-Edge Technology',
		description: 'Latest software tools and technologies including our One-Click RA Bills feature that automates billing, saving time and reducing administrative burden.',
	},
	{
		title: 'One-Click RA Bills',
		description: 'Seamless, instant generation of RA Bills with a single click, ensuring accurate billing, improved financial transparency, and efficient cash flow management.',
	},
	{
		title: 'Every Second Project Monitoring',
		description: 'Real-time project monitoring with live updates on progress, timelines, and budgets, allowing immediate issue identification and resolution for full project visibility.',
	},
	{
		title: 'Commitment to Quality & Safety',
		description: 'Strict adherence to safety protocols and industry standards, ensuring every project aspect meets or exceeds expectations with the highest quality workmanship.',
	},
];

const mainImageUrl = 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=800&h=600&fit=crop';
const overlayCards = [
	{
		image: 'https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=400&h=300&fit=crop',
		title: 'Team Collaboration',
		position: 'left-center',
	},
	{
		image: 'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=400&h=300&fit=crop',
		title: 'Project Planning',
		position: 'top-right',
	},
	{
		image: 'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?w=400&h=300&fit=crop',
		title: 'Site Management',
		position: 'bottom-center',
	},
];
---

<section id="why-valency" class="w-full bg-white md:pb-16">
	<div class="container mx-auto px-2 sm:px-4 lg:px-6">
		<div class="max-w-7xl mx-auto">
			<!-- Section Title -->
			<h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-12 text-center animate-fade-in-up">
				What Makes Us Unique
			</h2>
			
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-25 items-start">
				<!-- Left: Main Image with Overlay Cards -->
				<div 
					class="why-valency-image relative w-full rounded-xl overflow-visible shadow-xl mt-12 md:mt-16"
					style="opacity: 0; transition: opacity 0.8s ease-out 0.2s; min-height: 600px;"
				>
					<!-- Main Building Image -->
					<img
						src={mainImageUrl}
						alt="Modern Construction"
						class="w-full h-full object-cover absolute inset-0 rounded-xl"
						style="height: 100%; min-height: 600px; z-index: 1;"
					/>
					<div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent rounded-xl z-10"></div>
					
					<!-- Overlay Cards - Positioned individually (30% outside, 70% inside) -->
					{overlayCards.map((card, index) => {
						let positionClasses = '';
						if (card.position === 'left-center') {
							// 30% outside (left), 70% inside
							positionClasses = 'left-0 top-1/2 -translate-y-1/2';
						} else if (card.position === 'top-right') {
							// Extend outside at the top
							positionClasses = 'right-0 top-0';
						} else if (card.position === 'bottom-center') {
							// 50% outside (bottom), 50% inside
							positionClasses = 'left-1/2 bottom-0 -translate-x-1/2';
						}
						
						return (
							<div 
								class={`overlay-card absolute ${positionClasses} bg-white rounded-lg overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-300 w-[200px] md:w-[240px] z-20`}
								style={`
									opacity: 0; 
									transition: opacity 0.6s ease-out ${0.3 + index * 0.2}s, transform 0.6s ease-out ${0.3 + index * 0.2}s;
									${card.position === 'left-center' ? 'transform: translateX(-30%) translateY(-50%);' : ''}
									${card.position === 'top-right' ? 'transform: translateX(-20%) translateY(-30%);' : ''}
									${card.position === 'bottom-center' ? 'transform: translateX(-50%) translateY(50%);' : ''}
								`}
							>
								<img
									src={card.image}
									alt={card.title}
									class="w-full h-32 md:h-40 object-cover"
								/>
								<div class="p-3 bg-white">
									<p class="text-xs md:text-sm font-semibold text-gray-900">{card.title}</p>
								</div>
							</div>
						);
					})}
				</div>

				<!-- Right: Features List -->
				<div class="space-y-6 pl-4 md:pl-6">
					{features.map((feature, index) => (
						<div 
							class={`why-valency-item group flex gap-3 p-4 rounded-lg cursor-pointer bg-gray-50 shadow-sm border-2 border-transparent`}
							style={`opacity: 0; transform: translateX(50px) translateY(20px) scale(0.9); transition: opacity 1.2s cubic-bezier(0.4, 0, 0.2, 1), transform 1.2s cubic-bezier(0.4, 0, 0.2, 1); `}
						>
							<div class="flex-shrink-0 w-8 h-8 rounded-lg flex items-center justify-center transition-colors duration-300 bg-blue-900">
								<svg
									class="w-4 h-4 text-white"
									fill="none"
									stroke="currentColor"
									viewBox="0 0 24 24"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M5 13l4 4L19 7"
									></path>
								</svg>
							</div>
							<div>
								<h3 class="text-base md:text-lg font-bold mb-1.5 text-gray-900 transition-colors duration-300">
									{feature.title}
								</h3>
								<p class="text-sm md:text-base leading-relaxed text-gray-600 transition-colors duration-300">
									{feature.description}
								</p>
							</div>
						</div>
					))}
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	const whyValencySection = document.getElementById('why-valency');
	if (whyValencySection) {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('visible');
						
						// Animate image
						const image = entry.target.querySelector('.why-valency-image') as HTMLElement | null;
						if (image) {
							image.style.opacity = '1';
						}
						
						// Animate overlay cards
						const overlayCards = entry.target.querySelectorAll('.overlay-card');
						overlayCards.forEach((card, index) => {
							const htmlCard = card as HTMLElement;
							setTimeout(() => {
								htmlCard.style.opacity = '1';
								// Keep the existing transform from inline styles
							}, 500 + index * 100);
						});
						
						// Animate items with smooth animation
						const items = entry.target.querySelectorAll('.why-valency-item');
						items.forEach((item) => {
							const htmlItem = item as HTMLElement;
							const index = Array.from(items).indexOf(item);
							const delay = 0.5 + index * 0.3;
							
							setTimeout(() => {
								htmlItem.style.opacity = '1';
								htmlItem.style.transform = 'translateX(0) translateY(0) scale(1)';
								
								// After initial animation, remove inline transition to allow CSS hover transition
								setTimeout(() => {
									htmlItem.style.transition = '';
								}, 1200);
							}, delay * 1000);
						});
					}
				});
			},
			{ threshold: 0.1 }
		);
		observer.observe(whyValencySection);
	}

</script>

<style>
	.animate-fade-in-up {
		opacity: 0;
		transform: translateY(60px);
		transition: opacity 0.6s ease-out, transform 0.6s ease-out;
	}

	#why-valency.visible .animate-fade-in-up {
		opacity: 1;
		transform: translateY(0);
	}

	.why-valency-item {
		transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1),
		            box-shadow 0.5s cubic-bezier(0.4, 0, 0.2, 1),
		            background-color 0.5s cubic-bezier(0.4, 0, 0.2, 1),
		            border-color 0.5s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.why-valency-item:hover {
		background-color: #eff6ff;
		box-shadow: 0 20px 25px -5px rgba(59, 130, 246, 0.1), 0 10px 10px -5px rgba(59, 130, 246, 0.04);
		border-color: #bfdbfe;
		transform: translateY(-4px) scale(1.02);
	}

</style>
