---

<section id="services" class="w-full bg-white pb-10 md:pb-16">
	<div class="container mx-auto px-2 sm:px-4 lg:px-6">
		<div class="max-w-7xl mx-auto">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-12">
				<div class="animate-fade-in-up">
					<p class="text-red-600 text-lg md:text-xl font-semibold mb-2">
						Innovative Engineering Solutions to Meet Your Needs
					</p>
					<h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
						Our Services
					</h2>
					<p class="text-gray-600 text-lg mb-6">
						At Valency Engineering Consultancy, we provide a full spectrum of services that ensure exceptional quality and precision across all stages of a project. Our offerings include:
					</p>
				</div>
				<!-- <div class="flex items-end justify-end animate-fade-in-right">
					<button class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3  transition-colors flex items-center gap-2 group">
					</button>
				</div> -->
			</div>

			<!-- Services Horizontal Scroll Container -->
			<div class="overflow-x-auto pb-4 scrollbar-hide" id="services-scroll" style="scroll-behavior: smooth; cursor: grab; scrollbar-width: thin; -webkit-overflow-scrolling: touch;">
				<div class="flex gap-6 md:gap-8 px-2" style="min-width: max-content; width: max-content;">
					{services.map((service, index) => (
						<div 
							class={`service-card relative flex-shrink-0 w-66 md:w-80 h-80 md:h-[400px] rounded-md overflow-hidden cursor-pointer animate-rotate-in`}
							style={`animation-delay: ${index * 0.15}s; transition-delay: ${index * 0.15}s;`}
							data-service-index={index}
						>
							{service.image && (
								<img 
									src={service.image}
									alt={service.title}
									class="service-card-image w-full h-full object-cover transition-transform duration-500"
								/>
							)}
							<div class="service-gradient absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent opacity-0 transition-opacity duration-300"></div>

							<!-- Content Overlay -->
							<div class="absolute bottom-0 left-0 right-0 p-6 md:p-8 text-white">
								<h3 class="text-2xl md:text-3xl font-bold mb-3">{service.title}</h3>
								<p class="service-description text-white/90 text-sm md:text-base leading-relaxed mb-2 opacity-0 max-h-0 overflow-hidden transition-all duration-300">
									{service.description}
								</p>
								<div class="service-card-description overflow-hidden transition-all duration-300" style="max-height: 0; opacity: 0;">
									<ul class="text-white/90 text-xs md:text-sm leading-relaxed mt-3 space-y-1.5 list-disc list-inside">
										{service.bullets?.map((bullet) => (
											<li>{bullet}</li>
										))}
									</ul>
								</div>
							</div>
						</div>
					))}
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	// Intersection Observer for section animation
	const servicesSection = document.getElementById('services');
	if (servicesSection) {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						setTimeout(() => {
							entry.target.classList.add('visible');
						}, 200);
					}
				});
			},
			{ rootMargin: '0px 0px -100px 0px' }
		);
		observer.observe(servicesSection);
	}

	// Service card hover effects
	document.querySelectorAll('.service-card').forEach((card) => {
		const htmlCard = card as HTMLElement;
		const gradient = card.querySelector('.service-gradient') as HTMLElement | null;
		const mainDescription = card.querySelector('.service-description') as HTMLElement | null;
		const bulletsDescription = card.querySelector('.service-card-description') as HTMLElement | null;
		const image = card.querySelector('.service-card-image') as HTMLImageElement | null;

		htmlCard.addEventListener('mouseenter', () => {
			htmlCard.style.transform = 'translateY(-8px) rotate(1deg)';
			if (gradient) {
				gradient.style.opacity = '1';
			}
			if (mainDescription) {
				mainDescription.style.opacity = '1';
				mainDescription.style.maxHeight = '100px';
			}
			if (bulletsDescription) {
				bulletsDescription.style.maxHeight = '300px';
				bulletsDescription.style.opacity = '1';
			}
			if (image) {
				image.style.transform = 'scale(1.1)';
			}
		});

		htmlCard.addEventListener('mouseleave', () => {
			htmlCard.style.transform = 'translateY(0) rotate(0deg)';
			if (gradient) {
				gradient.style.opacity = '0';
			}
			if (mainDescription) {
				mainDescription.style.opacity = '0';
				mainDescription.style.maxHeight = '0';
			}
			if (bulletsDescription) {
				bulletsDescription.style.maxHeight = '0';
				bulletsDescription.style.opacity = '0';
			}
			if (image) {
				image.style.transform = 'scale(1)';
			}
		});
	});
</script>

<style>
	.animate-fade-in-up {
		opacity: 0;
		transform: translateY(60px);
		transition: opacity 0.6s ease-out, transform 0.6s ease-out;
	}

	.animate-fade-in-right {
		opacity: 0;
		transform: translateX(60px);
		transition: opacity 0.6s ease-out, transform 0.6s ease-out;
	}

	#services.visible .animate-fade-in-up,
	#services.visible .animate-fade-in-right {
		opacity: 1;
		transform: translateY(0) translateX(0);
	}

	.animate-rotate-in {
		opacity: 0;
		transform: translateY(50px) scale(0.8);
		transition: opacity 0.8s ease-out, transform 0.8s ease-out;
	}

	#services.visible .animate-rotate-in {
		opacity: 1;
		transform: translateY(0) scale(1);
	}

	.service-card {
		transition: transform 1s ease-out;
	}

	.scrollbar-hide {
		scrollbar-width: thin;
		scrollbar-color: rgba(156, 163, 175, 0.3) transparent;
	}

	.scrollbar-hide::-webkit-scrollbar {
		height: 8px;
	}

	.scrollbar-hide::-webkit-scrollbar-track {
		background: transparent;
	}

	.scrollbar-hide::-webkit-scrollbar-thumb {
		background: rgba(156, 163, 175, 0.3);
		border-radius: 4px;
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.scrollbar-hide:hover::-webkit-scrollbar-thumb {
		opacity: 1;
	}

	.scrollbar-hide:hover {
		scrollbar-color: rgba(156, 163, 175, 0.6) transparent;
	}
</style>
