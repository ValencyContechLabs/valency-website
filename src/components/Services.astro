---
const services = [
	{
		number: '01',
		title: 'Civil Engineering & Infrastructure',
		description: 'Comprehensive infrastructure solutions for modern cities and communities. We design and build sustainable infrastructure that supports economic growth and improves quality of life.',
		image: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=800&h=600&fit=crop',
		isFeatured: true,
	},
	{
		number: '02',
		title: 'Interior Design',
		description: 'Creating functional and aesthetically pleasing interior spaces that reflect your brand identity and enhance user experience through innovative design solutions.',
		image: 'https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=800&h=600&fit=crop',
	},
	{
		number: '03',
		title: 'Structural Design',
		description: 'Advanced structural engineering services ensuring safety, durability, and efficiency in every project from concept to completion.',
		image: 'https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=800&h=600&fit=crop',
	},
	{
		number: '04',
		title: 'Planning & Project Management',
		description: 'Strategic planning and comprehensive project management services to ensure timely delivery and uncompromised quality throughout the project lifecycle.',
		image: 'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=800&h=600&fit=crop',
	},
	{
		number: '05',
		title: 'Mechanical, Electrical & Plumbing',
		description: 'Integrated MEP solutions that optimize energy efficiency, reduce operational costs, and ensure reliable building systems for modern infrastructure.',
		image: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=800&h=600&fit=crop',
	},
	{
		number: '06',
		title: 'Management & Site Supervision',
		description: 'On-site supervision and management services ensuring quality control, safety compliance, and seamless coordination between all project stakeholders.',
		image: 'https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=800&h=600&fit=crop',
	},
];
---

<section id="services" class="w-full bg-white pb-10 md:pb-16">
	<div class="container mx-auto px-4 sm:px-6 lg:px-8">
		<div class="max-w-7xl mx-auto">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-12">
				<div class="animate-fade-in-up">
					<p class="text-red-600 text-lg md:text-xl font-semibold mb-2">
						Innovative Engineering Solutions to Meet Your Needs
					</p>
					<h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
						Our Services
					</h2>
					<p class="text-gray-600 text-lg mb-6">
						At Valency Engineering Consultancy, we provide a full spectrum of services that ensure exceptional quality and precision across all stages of a project. Our offerings include:
					</p>
				</div>
				<!-- <div class="flex items-end justify-end animate-fade-in-right">
					<button class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3  transition-colors flex items-center gap-2 group">
					</button>
				</div> -->
			</div>

			<!-- Services Horizontal Scroll Container -->
			<div class="overflow-x-auto pb-4 scrollbar-hide" id="services-scroll" style="scroll-behavior: smooth; cursor: grab;">
				<div class="flex gap-6 md:gap-8 px-2" style="min-width: max-content;">
					{services.map((service, index) => (
						<div 
							class={`service-card relative flex-shrink-0 w-66 md:w-80 h-80 md:h-[400px] rounded-md overflow-hidden cursor-pointer animate-rotate-in`}
							// style={`animation-delay: ${index * 0.2}s;`}
							data-service-index={index}
						>
							{service.image && (
								<img 
									src={service.image}
									alt={service.title}
									class="service-card-image w-full h-full object-cover transition-transform duration-500"
								/>
							)}
							<div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent"></div>

							<!-- Number Badge -->
							<div class="absolute top-4 left-4 w-10 h-10 bg-white rounded-full flex items-center justify-center z-10">
								<span class="text-blue-900 font-bold">{service.number}</span>
							</div>

							<!-- Content Overlay -->
							<div class="absolute bottom-0 left-0 right-0 p-6 md:p-8 text-white">
								<h3 class="text-2xl md:text-3xl font-bold mb-3">{service.title}</h3>
								<div class="service-card-description overflow-hidden transition-all duration-300" style="max-height: 0; opacity: 0;">
									<p class="text-white/90 text-sm md:text-base leading-relaxed mt-2">
										{service.description}
									</p>
								</div>
							</div>
						</div>
					))}
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	// Intersection Observer for section animation
	const servicesSection = document.getElementById('services');
	if (servicesSection) {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						setTimeout(() => {
							entry.target.classList.add('visible');
						}, 200);
					}
				});
			},
			{ rootMargin: '0px 0px -100px 0px' }
		);
		observer.observe(servicesSection);
	}

	// Service card hover effects
	document.querySelectorAll('.service-card').forEach((card) => {
		const htmlCard = card as HTMLElement;
		const description = card.querySelector('.service-card-description') as HTMLElement | null;
		const image = card.querySelector('.service-card-image') as HTMLImageElement | null;

		htmlCard.addEventListener('mouseenter', () => {
			htmlCard.style.transform = 'translateY(-8px) rotate(1deg)';
			if (description) {
				description.style.maxHeight = '200px';
				description.style.opacity = '1';
			}
			if (image) {
				image.style.transform = 'scale(1.1)';
			}
		});

		htmlCard.addEventListener('mouseleave', () => {
			htmlCard.style.transform = 'translateY(0) rotate(0deg)';
			if (description) {
				description.style.maxHeight = '0';
				description.style.opacity = '0';
			}
			if (image) {
				image.style.transform = 'scale(1)';
			}
		});
	});
</script>

<style>
	.animate-fade-in-up {
		opacity: 0;
		transform: translateY(60px);
		transition: opacity 0.6s ease-out, transform 0.6s ease-out;
	}

	.animate-fade-in-right {
		opacity: 0;
		transform: translateX(60px);
		transition: opacity 0.6s ease-out, transform 0.6s ease-out;
	}

	#services.visible .animate-fade-in-up,
	#services.visible .animate-fade-in-right {
		opacity: 1;
		transform: translateY(0) translateX(0);
	}

	.animate-rotate-in {
		opacity: 0;
		transform: rotate(-10deg) scale(0.9);
		transition: opacity 0.6s ease-out, transform 0.6s ease-out;
	}

	#services.visible .animate-rotate-in {
		opacity: 1;
		transform: rotate(0deg) scale(1);
	}

	.service-card {
		transition: transform 1s ease-out;
	}
</style>
