		],
		image: 'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=800&h=600&fit=crop',
		isFeatured: true,
	},
	{
		number: '02',
		title: 'Construction Management',
		description: 'Expert coordination of all construction activities from start to finish.',
		bullets: [
			'On-site supervision and contractor coordination',
			'Resource planning and workflow optimization',
			'Safety management and regulatory compliance',
			'Timeline management and progress control',
			'Issue resolution and performance tracking'
		],
		image: 'https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=800&h=600&fit=crop',
	},
	{
		number: '03',
		title: 'General Contracting',
		description: 'Single-point responsibility for seamless construction execution.',
		bullets: [
