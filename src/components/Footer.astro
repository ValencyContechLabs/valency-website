---
const processSteps = [
	{
		title: 'Discovery & Consultation',
		description: 'We start by understanding your goals, conducting project needs to define the right approach.',
	},
	{
		title: 'Design & Planning',
		description: 'Our team creates detailed designs and comprehensive plans tailored to your requirements.',
	},
	{
		title: 'Execution & Management',
		description: 'We oversee every aspect of implementation ensuring quality and timely delivery.',
	},
	{
		title: 'Quality Assurance',
		description: 'Rigorous testing and quality checks ensure the final output meets all specifications.',
	},
];
---

<footer id="contact" class="w-full bg-blue-900 text-white pb-10 md:py-16">
	<div class="container mx-auto px-4 sm:px-6 lg:px-8">
		<!-- Process Section -->
		<div class="max-w-7xl mx-auto mb-16">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-12">
				<div class="animate-fade-in-left">
					<h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-4">
						Our Process to Bring Your Ideas to Life
					</h2>
					<p class="text-white/80 text-lg">
						We follow a structured approach that ensures your vision becomes reality with precision and excellence.
					</p>
				</div>
			</div>

			<!-- Process Steps -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
				{processSteps.map((step, index) => (
					<div 
						class="process-card bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl p-6 hover:bg-white/15 transition-colors animate-fade-in-left"
						style={`animation-delay: ${index * 0.3}s;`}
					>
						<div class="w-12 h-12 bg-white/20 rounded-lg flex items-center justify-center mb-4">
							<span class="text-2xl font-bold">{index + 1}</span>
						</div>
						<h3 class="text-xl font-bold mb-3">{step.title}</h3>
						<p class="text-white/80">{step.description}</p>
					</div>
				))}
			</div>
		</div>

		<!-- Contact Section -->
		<div class="border-t border-white/20 pt-12">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
				<!-- Left Side: Contact Details -->
				<div class="space-y-4">
					<h3 class="text-2xl font-bold mb-6">Contact Us</h3>
					<div class="space-y-4">
						<p class="flex items-start">
							<svg class="w-5 h-5 mr-3 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
							</svg>
							<span class="text-white/90">123 Business Street, Suite 100<br />San Francisco, CA 94105</span>
						</p>
						<p class="flex items-center">
							<svg class="w-5 h-5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
							</svg>
							<span class="text-white/90">+1 (555) 123-4567</span>
						</p>
						<p class="flex items-center">
							<svg class="w-5 h-5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
							</svg>
							<span class="text-white/90">hello@valency.com</span>
						</p>
					</div>
				</div>

				<!-- Right Side: Book a Demo Button -->
				<div class="flex flex-col justify-center items-start md:items-end">
					<button class="bg-white hover:bg-gray-100 text-blue-900 font-semibold px-8 py-4 rounded-lg transition-colors shadow-lg hover:shadow-xl text-lg w-full md:w-auto">
						Book a Demo
					</button>
				</div>
			</div>
			
			<!-- Footer Bottom -->
			<div class="mt-12 pt-8 border-t border-white/20 text-center text-sm text-white/60">
				<p>&copy; 2024 Valency Engineering Consultancy. All rights reserved.</p>
			</div>
		</div>
	</div>
</footer>

<script>
	const footerSection = document.getElementById('contact');
	if (footerSection) {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('visible');
					}
				});
			},
			{ threshold: 0.1 }
		);
		observer.observe(footerSection);
	}

	// Process card hover effects
	document.querySelectorAll('.process-card').forEach((card) => {
		const htmlCard = card as HTMLElement;
		htmlCard.addEventListener('mouseenter', () => {
			htmlCard.style.transform = 'scale(1.05) translateY(-5px)';
		});

		htmlCard.addEventListener('mouseleave', () => {
			htmlCard.style.transform = 'scale(1) translateY(0)';
		});
	});
</script>

<style>
	.animate-fade-in-left {
		opacity: 0;
		transform: translateX(-60px);
		transition: opacity 0.6s ease-out, transform 0.6s ease-out;
	}

	#contact.visible .animate-fade-in-left {
		opacity: 1;
		transform: translateX(0);
	}

	.process-card {
		transition: transform 0.4s ease-out;
	}
</style>
