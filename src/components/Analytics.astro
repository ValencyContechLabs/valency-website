<section id="analytics" class="w-full bg-white pb-10 md:pb-16">
	<div class="container mx-auto px-4 sm:px-6 lg:px-8">
		<h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-12 text-center">
			Analytics
		</h2>
		
		<!-- Horizontal Scrollable Image Container -->
		<div class="overflow-x-auto pb-4 scrollbar-hide">
			<div class="flex justify-center md:justify-start px-2" style="scroll-behavior: smooth;">
				<img 
					src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=917&h=524&fit=crop" 
					alt="Analytics Dashboard" 
					class="rounded-xl shadow-lg flex-shrink-0 w-full max-w-full md:max-w-none"
					width="917"
					height="524"
					style="min-width: min(917px, 100%);"
				/>
			</div>
		</div>
	</div>
</section>

<style>
	.scrollbar-hide {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}
	.scrollbar-hide::-webkit-scrollbar {
		display: none;
	}
</style>

