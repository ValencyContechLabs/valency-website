---
const features = [
	{
		title: 'One-Click Billing',
		description: 'Automates the entire billing workflow, minimizing manual intervention, reducing errors, and significantly accelerating payment cycles.',
	},
	{
		title: 'Real-Time Project Tracking',
		description: 'Provides live visibility into project progress, delays, milestones, and detailed cost breakdowns—keeping all stakeholders informed at every stage.',
	},
	{
		title: 'Productivity Insights',
		description: 'Activity-based tracking of labor, materials, and resources helps identify inefficiencies, optimize utilization, and ensure maximum on-site productivity.',
	},
	{
		title: 'Projections & Estimations',
		description: 'Delivers accurate forecasts for timelines, costs, and potential risks, enabling proactive decision-making and better control over project outcomes.',
	},
];
---

<section id="statistics" class="relative w-full py-10 md:py-16 overflow-hidden">
	<!-- Background Image -->
	<div class="absolute inset-0 statistics-bg-container">
		<img 
			src="https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=1920&h=1080&fit=crop" 
			class="w-full h-full object-cover statistics-bg-image"
			alt="What Valency Delivers Background"
		/>
		<div class="absolute inset-0 bg-black/50"></div>
	</div>

	<div class="relative z-10 container mx-auto px-2 sm:px-4 lg:px-6">
		<div class="max-w-7xl mx-auto">
			<!-- Header Section -->
			<div class="text-center mb-12 animate-fade-in-up">
				<h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4">
					What Valency Delivers
				</h2>
				<p class="text-white/90 text-lg max-w-3xl mx-auto">
					Valency empowers construction teams with intelligent tools designed to simplify complexity, improve visibility, and drive cost-efficient project execution.
				</p>
			</div>

			<!-- Features Grid -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-10 lg:gap-12">
				{features.map((feature, index) => (
					<div 
						class="statistics-card bg-white/95 backdrop-blur-sm rounded-xl p-6 border-2 border-white/20 shadow-lg animate-scale-in"
						style={`animation-delay: ${index * 0.1}s;`}
					>
						<h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-3">
							{feature.title}
						</h3>
						<p class="text-gray-600 text-base leading-relaxed">
							{feature.description}
						</p>
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<script>
	const statisticsSection = document.getElementById('statistics');
	if (statisticsSection) {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('visible');
					}
				});
			},
			{ threshold: 0.1 }
		);
		observer.observe(statisticsSection);
	}
</script>

<style>
	.animate-fade-in-up {
		opacity: 0;
		transform: translateY(60px);
		transition: opacity 0.6s ease-out, transform 0.6s ease-out;
	}

	.animate-scale-in {
		opacity: 0;
		transform: scale(0.8);
		transition: opacity 0.5s ease-out, transform 0.5s ease-out;
	}

	#statistics.visible .animate-fade-in-up,
	#statistics.visible .animate-scale-in {
		opacity: 1;
		transform: translateY(0) scale(1);
	}

	.statistics-card {
		transition: background-color 0.5s cubic-bezier(0.4, 0, 0.2, 1),
		            box-shadow 0.5s cubic-bezier(0.4, 0, 0.2, 1),
		            border-color 0.5s cubic-bezier(0.4, 0, 0.2, 1),
		            transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
		cursor: pointer;
	}

	.statistics-card:hover {
		background-color: rgba(255, 255, 255, 1);
		box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2), 0 10px 10px -5px rgba(0, 0, 0, 0.1);
		border-color: rgba(255, 255, 255, 0.4);
		transform: translateY(-4px);
	}

	/* Statistics Background Image */
	.statistics-bg-image {
		opacity: 0;
		transform: scale(1.1);
		animation: statisticsBgFadeIn 2s ease-out forwards;
	}

	@keyframes statisticsBgFadeIn {
		to {
			opacity: 1;
			transform: scale(1);
		}
	}
</style>
