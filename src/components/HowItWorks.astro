<section id="how-it-works" class="w-full bg-white pb-10 md:pb-16">
	<div class="container mx-auto px-2 sm:px-4 lg:px-6">
		<div class="max-w-7xl mx-auto">
			<!-- Section 1: High-Level Flow -->
