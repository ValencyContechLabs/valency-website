						<div class="flex items-center justify-center w-12 h-12 bg-blue-600 text-white rounded-full text-xl font-bold mb-4">
							1
						</div>
						<h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-3">
							BOQ Setup
