					</div>

					<div class="automation-card bg-gradient-to-br from-indigo-50 to-indigo-100 rounded-xl p-6 md:p-8 border-2 border-indigo-200">
						<h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-4">
