</section>

<script>
	const howItWorksSection = document.getElementById('how-it-works');
	if (howItWorksSection) {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('visible');
						
						// Animate header
						const title = entry.target.querySelector('.how-it-works-title') as HTMLElement | null;
						const subtitle = entry.target.querySelector('.how-it-works-subtitle') as HTMLElement | null;
						if (title) {
							setTimeout(() => {
								title.style.opacity = '1';
								title.style.transform = 'translateY(0)';
							}, 100);
						}
						if (subtitle) {
							setTimeout(() => {
								subtitle.style.opacity = '1';
								subtitle.style.transform = 'translateY(0)';
							}, 300);
						}
						
						// Animate flow cards
						const flowCards = entry.target.querySelectorAll('.flow-card');
						flowCards.forEach((card, index) => {
							setTimeout(() => {
								const htmlCard = card as HTMLElement;
								htmlCard.style.opacity = '1';
								htmlCard.style.transform = 'translateY(0)';
							}, 500 + index * 150);
						});
						
						// Animate setup cards
						const setupCards = entry.target.querySelectorAll('.setup-card');
						setupCards.forEach((card, index) => {
							setTimeout(() => {
								const htmlCard = card as HTMLElement;
								htmlCard.style.opacity = '1';
								htmlCard.style.transform = 'translateY(0)';
							}, 1200 + index * 150);
						});
						
						// Animate workflow cards
						const workflowCards = entry.target.querySelectorAll('.workflow-card');
						workflowCards.forEach((card, index) => {
							setTimeout(() => {
								const htmlCard = card as HTMLElement;
								htmlCard.style.opacity = '1';
								htmlCard.style.transform = 'translateY(0)';
							}, 1800 + index * 100);
						});
						
						// Animate automation cards
						const automationCards = entry.target.querySelectorAll('.automation-card');
						automationCards.forEach((card, index) => {
							setTimeout(() => {
								const htmlCard = card as HTMLElement;
								htmlCard.style.opacity = '1';
								htmlCard.style.transform = 'translateY(0)';
							}, 2500 + index * 150);
						});
						
						// Animate outcome cards
						const outcomeCards = entry.target.querySelectorAll('.outcome-card');
						outcomeCards.forEach((card, index) => {
							setTimeout(() => {
								const htmlCard = card as HTMLElement;
								htmlCard.style.opacity = '1';
								htmlCard.style.transform = 'translateY(0)';
							}, 3200 + index * 150);
						});
					}
				});
			},
			{ threshold: 0.1 }
		);
		observer.observe(howItWorksSection);
	}
</script>

<style>
	.how-it-works-title {
		opacity: 0;
		transform: translateY(30px);
		transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1), transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.how-it-works-subtitle {
		opacity: 0;
		transform: translateY(20px);
		transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1), transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.flow-card,
	.setup-card,
	.workflow-card,
	.automation-card,
	.outcome-card {
		opacity: 0;
		transform: translateY(30px);
		transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), 
		            transform 0.6s cubic-bezier(0.4, 0, 0.2, 1),
		            box-shadow 0.3s ease,
		            border-color 0.3s ease;
	}

	.setup-card {
		transition: background-color 0.5s cubic-bezier(0.4, 0, 0.2, 1),
		            box-shadow 0.5s cubic-bezier(0.4, 0, 0.2, 1),
		            border-color 0.5s cubic-bezier(0.4, 0, 0.2, 1),
		            transform 0.5s cubic-bezier(0.4, 0, 0.2, 1),
		            opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1);
		cursor: pointer;
	}

	.setup-card:hover {
		background-color: #eff6ff;
		box-shadow: 0 20px 25px -5px rgba(59, 130, 246, 0.1), 0 10px 10px -5px rgba(59, 130, 246, 0.04);
		border-color: #bfdbfe;
		transform: translateY(-4px);
	}

	.flow-card:hover,
	.automation-card:hover,
	.outcome-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
	}
</style>

