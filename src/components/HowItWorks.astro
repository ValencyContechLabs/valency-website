					<div class="outcome-card bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl p-6 md:p-8 border-2 border-blue-200">
						<div class="text-4xl md:text-5xl font-bold text-blue-600 mb-3">100%</div>
