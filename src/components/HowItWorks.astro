			<!-- Section 4: System Automation -->
			<div class="mb-16 md:mb-20">
				<div class="text-center mb-12">
					<h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
						Automated Control Engine
					</h2>
					<p class="text-gray-600 text-lg max-w-2xl mx-auto">
						Where the magic happens — Once daily inputs are completed, Valency automatically handles the rest
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 automation-cards">
					<div class="automation-card bg-gradient-to-br from-indigo-50 to-indigo-100 rounded-xl p-6 md:p-8 border-2 border-indigo-200">
