---
const heroImages = [
  "https://images.unsplash.com/photo-1583024011792-b165975b52f5?q=80&w=1632&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1627660080110-20045fd3875d?q=80&w=1170&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1656329890168-a8f3888e9d71?q=80&w=2070&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1589939705384-5185137a7f0f?q=80&w=1170&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1602497485099-e41a116a272c?q=80&w=2070&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1615461476249-718ef8bc369c?q=80&w=1974&auto=format&fit=crop",
];

const stats = [
  { value: "5–7%", label: "Cost savings", sub: "Automated billing" },
  { value: "5–10%", label: "Cost savings", sub: "Material management" },
  { value: "2 Min", label: "Daily input", sub: "Per task, per engineer" },
  { value: "100%", label: "Live visibility", sub: "Mobile & desktop" },
];
---

<section
  id="home"
  class="relative w-full min-h-[620px] md:min-h-[720px] lg:min-h-[820px] overflow-hidden -mt-20 md:-mt-24"
>
  <!-- Rotating Background Images -->
  <div class="absolute hero-bg-extended inset-0" style="z-index:0;">
    {heroImages.map((src, i) => (
      <img
        src={src}
        class={`w-full h-full object-cover absolute inset-0 hero-bg-image ${i === 0 ? "hero-bg-active" : "hero-bg-inactive"}`}
        data-image-index={i}
        alt=""
        aria-hidden="true"
      />
    ))}
    <!-- Deep gradient overlay: dark on left for text legibility, lighter on right -->
    <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/30"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/20"></div>
  </div>

  <!-- Main Content -->
  <div class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8 flex flex-col justify-center min-h-[620px] md:min-h-[720px] lg:min-h-[820px] pt-28 md:pt-36 pb-0">

    <div class="max-w-3xl">
      <!-- Category Badge -->
      <div class="hero-entrance mb-6" style="animation-delay: 0.1s;">
        <span class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 text-white/90 text-xs font-semibold uppercase tracking-widest px-4 py-2 rounded-full">
          <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
          Construction Process Automation &amp; Control Software
        </span>
      </div>

      <!-- Headline -->
      <h1 class="hero-entrance text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6" style="animation-delay: 0.25s;">
        Enterprise Control That<br/>
        <span class="text-blue-400">Defines Your Financial</span><br/>
        Outcomes
      </h1>

      <!-- Subheadline -->
      <p class="hero-entrance text-white/80 text-lg md:text-xl leading-relaxed max-w-xl mb-10" style="animation-delay: 0.4s;">
        Automate billing, material management, labour tracking, and quality control — giving your construction business complete financial visibility and control.
      </p>

      <!-- CTA Buttons -->
      <div class="hero-entrance flex flex-wrap gap-4 mb-0" style="animation-delay: 0.55s;">
        <a
          href="/about"
          class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-semibold px-7 py-3.5 rounded-lg transition-all duration-200 shadow-lg shadow-blue-900/40 text-base"
        >
          Book a Free Demo
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a
          href="/how-it-works"
          class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 backdrop-blur-sm border border-white/30 text-white font-semibold px-7 py-3.5 rounded-lg transition-all duration-200 text-base"
        >
          See How It Works
        </a>
      </div>
    </div>
  </div>

  <!-- Stats Bar — pinned to the bottom of the hero -->
  <div class="relative z-10 w-full hero-entrance" style="animation-delay: 0.7s;">
    <div class="bg-black/60 backdrop-blur-md border-t border-white/10">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 lg:grid-cols-4 divide-x divide-white/10">
          {stats.map((stat) => (
            <div class="flex flex-col items-center justify-center py-5 px-4 text-center group hover:bg-white/5 transition-colors duration-200">
              <span class="text-2xl md:text-3xl font-bold text-blue-400 leading-none mb-1">{stat.value}</span>
              <span class="text-white text-xs font-semibold uppercase tracking-wider mb-0.5">{stat.label}</span>
              <span class="text-white/50 text-xs">{stat.sub}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Smooth scroll for cost-optimization-btn (legacy support)
  const costOptimizationBtn = document.getElementById("cost-optimization-btn");
  if (costOptimizationBtn) {
    costOptimizationBtn.addEventListener("click", () => {
      document.getElementById("built-for-future")?.scrollIntoView({ behavior: "smooth" });
    });
  }

  // Hero Image Rotation
  const heroImages = document.querySelectorAll(".hero-bg-image");
  let currentIndex = 0;
  const total = heroImages.length;

  function switchHeroImage() {
    if (!total) return;
    heroImages[currentIndex].classList.remove("hero-bg-active");
    heroImages[currentIndex].classList.add("hero-bg-inactive");
    currentIndex = (currentIndex + 1) % total;
    heroImages[currentIndex].classList.remove("hero-bg-inactive");
    heroImages[currentIndex].classList.add("hero-bg-active");
  }

  setTimeout(() => {
    if (total > 1) setInterval(switchHeroImage, 10000);
  }, 2000);
</script>

<style>
  .hero-bg-extended {
    top: -80px;
    height: calc(100% + 80px);
  }

  .hero-bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 2s ease-in-out, transform 12s ease-in-out;
  }
  .hero-bg-active  { opacity: 1; transform: scale(1);    z-index: 1; }
  .hero-bg-inactive{ opacity: 0; transform: scale(1.06); z-index: 0; }
  .hero-bg-image:first-child {
    animation: heroBgIn 1.4s ease-out forwards;
  }
  @keyframes heroBgIn {
    from { opacity: 0; transform: scale(1.08); }
    to   { opacity: 1; transform: scale(1);    }
  }

  /* Entrance animation for all hero content */
  .hero-entrance {
    opacity: 0;
    transform: translateY(24px);
    animation: heroFadeUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  @keyframes heroFadeUp {
    to { opacity: 1; transform: translateY(0); }
  }
</style>
