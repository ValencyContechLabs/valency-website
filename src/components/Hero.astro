---
---

<section id="home" class="relative w-full min-h-[600px] md:min-h-[700px] lg:min-h-[800px] overflow-hidden mb-16 py-12 flex ">
	<!-- Background Image with Overlay -->
	<div class="absolute inset-0">
		<img 
			src="https://images.unsplash.com/photo-1656329890168-a8f3888e9d71?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" 
			class="w-full h-full object-cover"
		/>
		<div class="absolute inset-0 bg-black/20"/>
	</div>

		<!-- Content -->
	<div class="relative z-10 container mx-auto px-2 sm:px-4 lg:px-6 h-full flex">
		<div class="max-w-xl w-full text-white">
			<div class="space-y-3">
				<!-- Main Title Card -->
				<div class="hero-title-card rounded-lg p-3">
					<h1 class="text-2xl md:text-3xl lg:text-4xl font-bold leading-tight">
						Revolutionising <span class="text-blue-400">Construction</span> Planning
					</h1>
				</div>

				<!-- Point 1 -->
				<div class="hero-card bg-white/10 backdrop-blur-sm rounded-lg p-3 border border-white/20">
					<h3 class="text-sm md:text-base font-bold mb-1.5">
						Clarity Through Complete Transparency
					</h3>
					<p class="text-xs text-white/90 leading-relaxed">
						Our advanced project management tools deliver real-time tracking and reporting, giving you full visibility into every stage of your project—no surprises, only informed decisions.
					</p>
				</div>

				<!-- Point 2 -->
				<div class="hero-card bg-white/10 backdrop-blur-sm rounded-lg p-3 border border-white/20">
					<h3 class="text-sm md:text-base font-bold mb-1.5">
						Precision in Execution, Excellence in Results
					</h3>
					<p class="text-xs text-white/90 leading-relaxed">
						We monitor every second and every detail to ensure your project is delivered on time, within budget, and to the highest quality standards.
					</p>
				</div>

				<!-- Point 3 -->
				<div class="hero-card bg-white/10 backdrop-blur-sm rounded-lg p-3 border border-white/20">
					<h3 class="text-sm md:text-base font-bold mb-1.5">
						Strong Partnerships, Seamless Delivery
					</h3>
					<p class="text-xs text-white/90 leading-relaxed">
						By connecting your vision with the right expertise, resources, and contractors, we create a coordinated and efficient construction journey from planning through completion.
					</p>
				</div>
			</div>
		</div>
	</div>

	<!-- Right Bottom Card -->
	<div class="absolute bottom-4 right-4 md:bottom-8 md:right-8 max-w-xs md:max-w-sm z-20">
		<div class="hero-bottom-card bg-white/10 backdrop-blur-sm rounded-lg p-4 md:p-5 border border-white/20">
			<h3 class="text-base md:text-lg font-bold mb-2 text-blue-300">
				Cost Optimization & Waste Reduction
			</h3>
			<p class="text-xs md:text-sm text-white/90 leading-relaxed mb-4">
				Through precise planning, real-time monitoring, and disciplined execution, we significantly reduce material and time wastage across projects. While typical construction projects experience up to 12% overall wastage, our structured management approach enables us to save up to 80% of that potential loss, resulting in substantial cost savings for the client over the total project lifecycle.
			</p>
			<button 
				id="cost-optimization-btn"
				class="w-full bg-black hover:bg-gray-800 text-white font-semibold py-2 px-4 rounded-lg transition-colors duration-300 text-sm md:text-base"
			>
				Learn More
			</button>
		</div>
	</div>
</section>

<script>
	const costOptimizationBtn = document.getElementById('cost-optimization-btn');
	if (costOptimizationBtn) {
		costOptimizationBtn.addEventListener('click', () => {
			const targetSection = document.getElementById('built-for-future');
			if (targetSection) {
				targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
		});
	}
</script>

<style>
	.hero-title-card {
		transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1),
		            opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1);
		cursor: default;
	}

	.hero-title-card:hover {
		transform: translateY(-4px);
		opacity: 0.95;
	}

	.hero-card {
		transition: background-color 0.5s cubic-bezier(0.4, 0, 0.2, 1),
		            border-color 0.5s cubic-bezier(0.4, 0, 0.2, 1),
		            transform 0.5s cubic-bezier(0.4, 0, 0.2, 1),
		            box-shadow 0.5s cubic-bezier(0.4, 0, 0.2, 1);
		cursor: pointer;
	}

	.hero-card:hover {
		background-color: rgba(255, 255, 255, 0.2);
		border-color: rgba(255, 255, 255, 0.4);
		transform: translateY(-4px) scale(1.02);
		box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3), 0 8px 10px -6px rgba(0, 0, 0, 0.2);
	}

	.hero-bottom-card {
		transition: background-color 0.5s cubic-bezier(0.4, 0, 0.2, 1),
		            border-color 0.5s cubic-bezier(0.4, 0, 0.2, 1),
		            transform 0.5s cubic-bezier(0.4, 0, 0.2, 1),
		            box-shadow 0.5s cubic-bezier(0.4, 0, 0.2, 1);
		cursor: pointer;
	}

	.hero-bottom-card:hover {
		background-color: rgba(255, 255, 255, 0.2);
		border-color: rgba(255, 255, 255, 0.4);
		transform: translateY(-6px) scale(1.03);
		box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.2);
	}
</style>

