<section id="home" class="relative w-full h-[600px] md:h-[600px] lg:h-[600px] overflow-hidden mb-16">
	<!-- Background Image with Overlay -->
	<div class="absolute inset-0">
		<img 
			src="https://images.unsplash.com/photo-1656329890168-a8f3888e9d71?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" 
			class="w-full h-full object-cover"
		/>
		<div class="absolute inset-0 bg-black/40"></div>
	</div>

	<!-- Content - Two Column Layout -->
	<div class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8 h-full flex items-start mt-28">
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 w-full">
			<!-- Left Side -->
			<!-- <div class="text-white">
				<p class="text-lg md:text-xl mb-4">
					Creativity and precision to deliver forward-thinking design solutions.
				</p>
				<button class="bg-black-600 hover:bg-black-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors">
					Explore Our Services
				</button>
			</div> -->

			<!-- Right Side -->
			<div class="text-white">
				<h2 class="text-2xl md:text-3xl font-bold mb-4">
					Explore Our Complete Project
				</h2>
				<p class="text-lg md:text-xl mb-6 text-white/90">
					We Carefully Manage Every Project To Ensure Timely Delivery With Uncompromised Quality.
				</p>
				<button class="bg-white hover:bg-blue-700 text-black font-semibold px-6 py-2 transition-colors flex items-center gap-2 group">
					<span>Learn more</span>
					<svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
					</svg>
				</button>
			</div>
		</div>
	</div>
</section>

