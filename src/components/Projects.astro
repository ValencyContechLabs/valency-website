---
const industries = [

	{
		title: 'Residential',
		description: 'We manage residential construction projects with a strong focus on quality, safety, and timely delivery. From apartment complexes to large-scale housing developments, we coordinate all stakeholders to ensure smooth execution, efficient resource management, and homes built to last—while meeting regulatory and client expectations.',
		image: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=800&h=600&fit=crop',
	},
	{
		title: 'Commercial',
		description: 'Our commercial construction management services support office buildings, retail spaces, and mixed-use developments. We understand the importance of deadlines and operational readiness, ensuring projects are delivered on schedule and within budget while maintaining high standards of functionality, aesthetics, and compliance.',
		image: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=800&h=600&fit=crop',
	},
	{
		title: 'Industrial',
		description: 'Industrial projects demand precision, safety, and technical expertise. We manage factories, warehouses, and processing facilities by closely monitoring schedules, workflows, and risks. Our approach ensures minimal disruption, optimized performance, and strict adherence to safety and industry standards.',
		image: 'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?w=800&h=600&fit=crop',
	},
	{
		title: 'Government / Public Sector',
		description: 'We support public sector and government projects with transparent reporting, strict compliance, and accountability. Our experience includes infrastructure and civic developments where efficiency, documentation, and adherence to public standards are essential for successful delivery.',
		image: 'https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=800&h=600&fit=crop',
	},
];
---

<section id="projects" class="w-full bg-white pb-10 md:pb-16">
	<div class="container mx-auto px-2 sm:px-4 lg:px-6">
		<div class="max-w-7xl mx-auto">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-12">
				<div class="animate-fade-in-left">
					<p class="text-red-600 text-lg md:text-xl font-semibold mb-2">
						Serving Diverse Sectors with Expertise
					</p>
					<h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
						Industries We Serve
					</h2>
					<p class="text-gray-600 text-lg mb-6">
						We bring specialized knowledge and proven project management expertise across multiple industries, ensuring tailored solutions that meet the unique requirements and standards of each sector.
					</p>
				</div>
			</div>

			<!-- Industries Gallery -->
			<div class="overflow-x-auto pb-4 scrollbar-hide" style="scrollbar-width: thin; -webkit-overflow-scrolling: touch;">
				<div class="flex gap-6 md:gap-8" style="min-width: max-content; width: max-content;">
					{industries.map((industry, index) => (
						<div 
							class="project-card relative flex-shrink-0 w-64 md:w-72 h-80 md:h-[360px] rounded-xl overflow-hidden group cursor-pointer animate-fade-in-left"
							style={`animation-delay: ${index * 0.6}s;`}
						>
							<img
								src={industry.image}
								alt={industry.title}
								class="project-card-image w-full h-full object-cover transition-transform duration-1000"
							/>
							<div class="industry-gradient absolute inset-0 bg-gradient-to-t from-black/70 via-black/50 to-black/20 opacity-0 transition-opacity duration-600"></div>
							<div class="absolute bottom-0 left-0 right-0 p-4 md:p-6 text-white z-10">
								<h3 class="text-xl md:text-2xl font-bold mb-2">{industry.title}</h3>
								<p class="industry-description text-white/95 text-xs md:text-sm leading-relaxed opacity-0 max-h-0 overflow-hidden transition-all duration-600">
									{industry.description}
								</p>
							</div>
						</div>
					))}
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	const projectsSection = document.getElementById('projects');
	if (projectsSection) {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('visible');
					}
				});
			},
			{ threshold: 0.1 }
		);
		observer.observe(projectsSection);
	}

	// Industry card hover effects
	document.querySelectorAll('.project-card').forEach((card) => {
		const htmlCard = card as HTMLElement;
		const image = card.querySelector('.project-card-image') as HTMLElement | null;
		const gradient = card.querySelector('.industry-gradient') as HTMLElement | null;
		const description = card.querySelector('.industry-description') as HTMLElement | null;

		htmlCard.addEventListener('mouseenter', () => {
			htmlCard.style.transform = 'scale(1.05) translateY(-5px)';
			if (image) {
				image.style.transform = 'scale(1.1)';
			}
			if (gradient) {
				gradient.style.opacity = '1';
			}
			if (description) {
				description.style.opacity = '1';
				description.style.maxHeight = '200px';
			}
		});

		htmlCard.addEventListener('mouseleave', () => {
			htmlCard.style.transform = 'scale(1) translateY(0)';
			if (image) {
				image.style.transform = 'scale(1)';
			}
			if (gradient) {
				gradient.style.opacity = '0';
			}
			if (description) {
				description.style.opacity = '0';
				description.style.maxHeight = '0';
			}
		});
	});
</script>

<style>
	.animate-fade-in-left {
		opacity: 0;
		transform: translateX(-60px);
		transition: opacity 1.2s ease-out, transform 1.2s ease-out;
	}

	.animate-fade-in-right {
		opacity: 0;
		transform: translateX(60px);
		transition: opacity 1.2s ease-out, transform 1.2s ease-out;
	}

	#projects.visible .animate-fade-in-left,
	#projects.visible .animate-fade-in-right {
		opacity: 1;
		transform: translateX(0);
	}

	.project-card {
		transition: transform 2s ease-out;
	}

	.scrollbar-hide {
		scrollbar-width: thin;
		scrollbar-color: rgba(156, 163, 175, 0.3) transparent;
	}

	.scrollbar-hide::-webkit-scrollbar {
		height: 8px;
	}

	.scrollbar-hide::-webkit-scrollbar-track {
		background: transparent;
	}

	.scrollbar-hide::-webkit-scrollbar-thumb {
		background: rgba(156, 163, 175, 0.3);
		border-radius: 4px;
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.scrollbar-hide:hover::-webkit-scrollbar-thumb {
		opacity: 1;
	}

	.scrollbar-hide:hover {
		scrollbar-color: rgba(156, 163, 175, 0.6) transparent;
	}
</style>
